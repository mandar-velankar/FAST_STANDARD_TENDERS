{
	"_version": "1.32.0",

	"sap.app": {
		"id": "com.bayer.tender.statenderapp",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",

		"applicationVersion": {
		"version": "0.0.2"
		},
		"resources": "resources.json",
		"dataSources": {
			"mainService": {
				"uri": "/v2/sta_tender/",
				"type": "OData",
				"settings": {
					"odataVersion": "2.0",
					"localUri": "localService/metadata.xml"
				}
			},
			"tempService": {
				"uri": "/UITemplates/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.0",
					"localUri": "localService/metadata.xml"
				}
			}
		}
	},

	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "sap-icon://detail-view",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},

	"sap.ui5": {
		"rootView": {
			"viewName": "com.bayer.tender.statenderapp.view.App",
			"type": "XML",
			"async": true,
			"id": "app"
		},

		"dependencies": {
			"minUI5Version": "1.66.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.f": {}
			}
		},

		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"componentUsages": {
		},
		"resourceRoots":{
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.bayer.tender.statenderapp.i18n.i18n"
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"defaultOperationMode": "Server",
					"defaultBindingMode": "TwoWay"
				}
			},
			"st": {
				"dataSource": "mainService",
				"preload": true,
				"type": "com.bayer.tender.statenderapp.state.StandardTenderState"
			},
			"template": {
				"dataSource": "tempService",
				"type": "com.bayer.tender.statenderapp.state.TemplateState"
			}
		},

		"routing": {
			"config": {
				"routerClass": "sap.f.routing.Router",
				"viewType": "XML",
				"viewPath": "com.bayer.tender.statenderapp.view",
				"controlId": "layout",
				"controlAggregation": "beginColumnPages",
				"bypassed": {
					"target": "notFound"
				},
				"async": true
			},

			"routes": [
				{
					"pattern": "",
					"name": "master",
					"target": "master"
				},
				{
					"pattern": "detail/{objectId}/{offerId}",
					"name": "object",
					"target": [
						"master",
						"object"
					]
				},
				{
					"pattern": "PT_TMTEND/{objectId}/AwardedDetail/{productId}/{layout}",
					"name": "objectDetail",
					"target": [
						"master",
						"object",
						"objectDetail"
					]
				},
				{
					"pattern": "PT_TMTEND/{objectId}/OfferProductDetail/{productId}/{layout}",
					"name": "offerProductDetail",
					"target": [
						"master",
						"object",
						"offerProductDetail"
					]
				}
			],

			"targets": {
				"master": {
					"viewName": "Master",
					"viewLevel": 1,
					"viewId": "master"
				},
				"object": {
					"viewName": "Detail",
					"viewId": "detail",
					"viewLevel": 1,
					"controlAggregation": "midColumnPages"
				},
				"objectDetail": {
					"viewName": "awards/views/AwardedProductsDetail",
					"controlAggregation": "endColumnPages"
				},
				"offerProductDetail": {
					"viewName": "offer/views/OfferProductsDetail",
					"controlAggregation": "endColumnPages"
				},
				"detailObjectNotFound": {
					"viewName": "DetailObjectNotFound",
					"viewId": "detailObjectNotFound",
					"controlAggregation": "midColumnPages"
				},
				"notFound": {
					"viewName": "NotFound",
					"viewId": "notFound"
				}
			}
		}
	},
    "sap.cloud": {
        "public": true,
        "service": "com-bayer-tender-statenderapp"
    }
}