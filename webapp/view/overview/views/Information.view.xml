						icon="sap-icon://decline"
						text="Cancel"
						press=".onTenderFormCancelBtnPress"
						visible="{= ${ui>/TenderForm/editMode} }"
					/>
				</Toolbar>
			</form:toolbar> -->
			<form:layout>
				<form:ResponsiveGridLayout
					labelSpanXL="{template>layout/labelSpanXL}"
					labelSpanL="{template>layout/labelSpanL}"
					labelSpanM="{template>layout/labelSpanM}"
					labelSpanS="{template>layout/labelSpanS}"
					adjustLabelSpan="{template>layout/adjustLabelSpan}"
					emptySpanXL="{template>layout/emptySpanXL}"
					emptySpanL="{template>layout/emptySpanL}"
					emptySpanM="{template>layout/emptySpanM}"
					emptySpanS="{template>layout/emptySpanS}"
					columnsXL="{template>layout/columnsXL}"
					columnsL="{template>layout/columnsL}"
					columnsM="{template>layout/columnsM}"
					singleContainerFullSize="{template>layout/singleContainerFullSize}" />
			</form:layout>
			<form:formContainers>
				<form:FormContainer title="{template>title}" formElements="{path:'template>formElements',templateShareable:true}">
					<form:formElements>
						<form:FormElement visible="{template>visible}" label="{template>label}" fields="{path:'template>controls',factory:'.fieldsFactory',templateShareable:true}">
							<!-- <form:fields>
								<Input value="{template>control/type}"/>
							</form:fields> -->
						</form:FormElement>
					</form:formElements>
				</form:FormContainer>
			</form:formContainers>
		</form:Form>
		</content>
	</Panel>

	<Panel expandable="true" width="auto" class="sapUiResponsiveMargin" expanded="true" backgroundDesign="Solid">
		<headerToolbar>
			<OverflowToolbar style="Standard" design="Solid">
					<Title text="Product Information" />
			</OverflowToolbar>
		</headerToolbar>
		<content>
			<Table 
				id="idProductInformationTable" 
				mode="SingleSelectMaster"
				
			>
				<columns>
					<Column>
						<Label text="Product" wrapping="true"/>
					</Column>
					<Column>
						<Label text="Qty" wrapping="true"/>
					</Column>
					<Column>
						<Label text="Unit Price" wrapping="true"/>
					</Column>
					<Column>
						<Label text="Pack Price" wrapping="true"/>
					</Column>
					<Column>
						<Label text="Total Amount" wrapping="true"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{ProductPackName}"/>	
							<Text text="100"/>
							<Text text="20.43 EUR"/>	
							<Text text="200.43 EUR"/>
							<Text text="{TotalAmount}"/>					
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Panel>

	<Panel expandable="false" width="auto" class="sapUiResponsiveMargin" backgroundDesign="Solid">
	<form:SimpleForm id="idRemarksIfno" editable="false" maxContainerCols="3" layout="ResponsiveGridLayout" labelSpanL="12" labelSpanM="12"
                        emptySpanL="0" emptySpanM="0" columnsL="3" columnsM="3" class="editableForm" visible="true">
		<form:content>
			
			<VBox fitContainer="true" alignItems="Stretch">
				<items>					
					<HBox visible="true">
						<items>
								
							<!-- Remarks -->
							<VBox class="sapUiSmallMarginEnd" width="50%" >
								<items>
									<Label text="{i18n>qStandardRemark}" design="Bold"/>
									<FormattedText htmlText="{fastAppData>/OfferValidation/REMARKS}" class="sapMText" />
								</items>
							</VBox>
									
							<!-- Additional remarks -->
							<VBox class="sapUiSmallMarginEnd" width="50%" alignItems="Start">
								<items>
									<Label text="{i18n>qCustomRemark}" design="Bold"/>
									<TextArea id="idCustomRemark" value="{path: 'fastAppData>/OfferValidation/CUSTOM_REMARKS'}" maxLength="500" enabled="false" height="10rem" width="30rem"/>
								</items>
							</VBox>									
								
						</items>
					</HBox>
					<Toolbar width="100%" height="1px" visible="true"/>	
					<HBox visible="true">
						<items>
							<!-- Issued by -->
							<VBox class="sapUiSmallMarginEnd" width="48%">
								<items>
									<Label text="{i18n>qIssuedBy}" design="Bold"/>
									<Select id="idSelectIssuedBy" 
										showSecondaryValues="true"
										selectedKey="{fastAppData>/OfferValidation/SELLING_COMPANY_AS1}" 
										enabled="false" 
											items="{ path: 'fastAppData>/EditOffer/Signatories/results'}">
										<core:ListItem text="{fastAppData>NAME}" additionalText="{fastAppData>TITLE}" key="{fastAppData>AUTHORIZED_SIGNATORY}"/>
									</Select>
								</items>
							</VBox>																
							<VBox width="1%">
							</VBox>	
							<!-- Company stamp -->
							<VBox class="sapUiSmallMarginEnd" width="48%" alignItems="Start">
								<items>
									<Label text="{i18n>qCompanyStamp}" design="Bold"/>
									<Select id="idSelectCompanyStamp" 
										showSecondaryValues="true"
										selectedKey="{fastAppData>/OfferValidation/SELLING_COMPANY_AS2}" 
										enabled="false" 
										items="{ path: 'fastAppData>/EditOffer/Signatories/results'}">
											<core:ListItem text="{fastAppData>NAME}" additionalText="{fastAppData>TITLE}" key="{fastAppData>AUTHORIZED_SIGNATORY}"/>
									</Select>
								</items>
							</VBox>
									
						</items>
					</HBox>
				</items>
			</VBox>
			
		</form:content>
	</form:SimpleForm>
	
	</Panel>

</mvc:View>