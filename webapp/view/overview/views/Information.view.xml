<mvc:View controllerName="com.bayer.tender.statenderapp.controller.Information.Information" 
	xmlns="sap.m"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt"
	xmlns:u="sap.uxap">

	<Panel expandable="true" width="auto" class="sapUiResponsiveMargin" backgroundDesign="Solid" expanded="true">
		<headerToolbar>
			<OverflowToolbar style="Standard" design="Solid">
				<Title text="Tender and Offer Details" />
				<ToolbarSpacer />
				<Button
					icon="sap-icon://alert"
					text="{= ${messages>/overviewTenderFormMsg}.length }"
					visible="{= ${messages>/overviewTenderFormMsg}.length > 0 &amp;&amp; ${ui>/OverviewTender/editMode}}"
					type="Emphasized"
					press="onMessagePopoverPress($event, 'overviewTenderFormMsg')"  
				/>
				<Button
					icon="sap-icon://edit"
					text="Edit"
					press=".onOverviewTenderFormEditBtnPress"
					visible="{= !${ui>/OverviewTender/editMode} }"
				/>
				<Button
					icon="sap-icon://save"
					text="Save"
					press=".onOverviewTenderFormSaveBtnPress"
					visible="{= ${ui>/OverviewTender/editMode} }"
				/>
				<Button
					icon="sap-icon://decline"
					text="Cancel"
					press=".onOverviewTenderFormCancelBtnPress"
					visible="{= ${ui>/OverviewTender/editMode} }"
				/>
				<Button id="ApprovalButtonId" text="Approvals" icon="sap-icon://validate" press="onApprovalsPress" enabled="true"/>

				<MenuButton text="Download" buttonMode="Split" useDefaultActionOnly="false">
					<menu>
						<Menu itemSelected="onMenuAction">
							<MenuItem text="Word" icon="sap-icon://doc-attachment">
								<items>
									<MenuItem text="Public Customer" />
									<MenuItem text="Private Customer" />
								</items>
							</MenuItem>
							<MenuItem text="PDF" icon="sap-icon://pdf-attachment">
								<items>
									<MenuItem text="Public Customer" />
									<MenuItem text="Private Customer" />
								</items>
							</MenuItem>
							<MenuItem text="Excel" icon="sap-icon://excel-attachment">
								<items>
									<MenuItem text="Public Customer" />
									<MenuItem text="Private Customer" />
								</items>
							</MenuItem>
						</Menu>
					</menu>
				</MenuButton>

				<Button
					id="btnSubmitQuotation"
					text="{i18n>SubmitQuotation}"
					icon="sap-icon://sys-enter"
					press=".onSubmitQuotation"
					enabled="false"/>
			</OverflowToolbar>
		</headerToolbar>
		<content>
			<form:Form
			id="idOverviewForm"
			editable="true"
			formContainers="{path:'template>/detailConfig/countryTemplate/template/tabByName/Overview/xmlView/formByName/OverviewForm/formContainers',templateShareable:true}">
			<!-- <form:title>
				<core:Title text="{template>title}" />
			</form:title>
			<form:toolbar>
				<Toolbar>
					<Title text="{template>title}"/>
					<ToolbarSpacer/>
					<Button
						icon="sap-icon://alert"
						text="{= ${messages>/basicInfoMsg}.length }"
						visible="{= ${messages>/basicInfoMsg}.length > 0 &amp;&amp; ${ui>/TenderForm/editMode}}"
						type="Emphasized"
						press="onMessagePopoverPress($event, 'basicInfoMsg')" 
					/>
					<Button
						id="idTenderFormEditBtn"
						icon="sap-icon://edit"
						text="Edit"
						press=".onTenderFormEditBtnPress"
						visible="{= !${ui>/TenderForm/editMode} }"
					/>
					<Button
						id="idTenderFormSaveBtn"
						icon="sap-icon://save"
						text="Save"
						press=".onTenderFormSaveBtnPress"
						visible="{= ${ui>/TenderForm/editMode} }"
					/>
					<Button
						id="idTenderFormCancelBtn"
						icon="sap-icon://decline"
						text="Cancel"
						press=".onTenderFormCancelBtnPress"
						visible="{= ${ui>/TenderForm/editMode} }"
					/>
				</Toolbar>
			</form:toolbar> -->
			<form:layout>
				<form:ResponsiveGridLayout
					labelSpanXL="{template>layout/labelSpanXL}"
					labelSpanL="{template>layout/labelSpanL}"
					labelSpanM="{template>layout/labelSpanM}"
					labelSpanS="{template>layout/labelSpanS}"
					adjustLabelSpan="{template>layout/adjustLabelSpan}"
					emptySpanXL="{template>layout/emptySpanXL}"
					emptySpanL="{template>layout/emptySpanL}"
					emptySpanM="{template>layout/emptySpanM}"
					emptySpanS="{template>layout/emptySpanS}"
					columnsXL="{template>layout/columnsXL}"
					columnsL="{template>layout/columnsL}"
					columnsM="{template>layout/columnsM}"
					singleContainerFullSize="{template>layout/singleContainerFullSize}" />
			</form:layout>
			<form:formContainers>
				<form:FormContainer title="{template>title}" formElements="{path:'template>formElements',templateShareable:true}">
					<form:formElements>
						<form:FormElement visible="{template>visible}" label="{template>label}" fields="{path:'template>controls',factory:'.fieldsFactory',templateShareable:true}">
							<!-- <form:fields>
								<Input value="{template>control/type}"/>
							</form:fields> -->
						</form:FormElement>
					</form:formElements>
				</form:FormContainer>
			</form:formContainers>
		</form:Form>
		</content>
	</Panel>

	<Panel expandable="true" width="auto" class="sapUiResponsiveMargin" expanded="true" backgroundDesign="Solid">
		<headerToolbar>
			<OverflowToolbar style="Standard" design="Solid">
					<Title text="Product Information" />
			</OverflowToolbar>
		</headerToolbar>
		<content>
			<Table 
				id="idProductInformationTable" 
				mode="SingleSelectMaster"
				
			>
				<columns>
					<Column>
						<Label text="Product" wrapping="true"/>
					</Column>
					<Column>
						<Label text="Qty" wrapping="true"/>
					</Column>
					<Column>
						<Label text="Unit Price" wrapping="true"/>
					</Column>
					<Column>
						<Label text="Pack Price" wrapping="true"/>
					</Column>
					<Column>
						<Label text="Total Amount" wrapping="true"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{ProductPackName}"/>	
							<Text text="100"/>
							<Text text="20.43 EUR"/>	
							<Text text="200.43 EUR"/>
							<Text text="{TotalAmount}"/>					
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Panel>
</mvc:View>