<mvc:View controllerName="com.bayer.tender.statenderapp.controller.Information.Information" 
	xmlns="sap.m"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt"
	xmlns:u="sap.uxap">

	
			<form:Form
			id="idOverviewForm"
			editable="true"
			formContainers="{path:'template>/detailConfig/countryTemplate/template/tabByName/Overview/xmlView/formByName/OverviewForm/formContainers',templateShareable:true}">
			<form:title>
				<core:Title text="{template>title}" />
			</form:title>
			<form:toolbar>
				<Toolbar>
					<Title text="{i18n>TenderandOfferDetails}" />
				<ToolbarSpacer />
				<Button
					icon="sap-icon://alert"
					text="{= ${messages>/overviewTenderFormMsg}.length }"
					visible="{= ${messages>/overviewTenderFormMsg}.length > 0 &amp;&amp; ${ui>/OverviewForm/editMode}}"
					type="Emphasized"
					press="onMessagePopoverPress($event, 'overviewTenderFormMsg')"  
				/>
				<Button
					icon="sap-icon://edit"
					text="Edit"
					press=".onOverviewTenderFormEditBtnPress"
					visible="{= !${ui>/OverviewForm/editMode} }"
					enabled = "{= ${em>/Detail/OverviewTab/OverviewForm/editMode}}"
				/>
				<Button
					icon="sap-icon://save"
					text="Save"
					press=".onOverviewTenderFormSaveBtnPress"
					visible="{= ${ui>/OverviewForm/editMode} }"
				/>
				<Button
					icon="sap-icon://decline"
					text="Cancel"
					press=".onOverviewTenderFormCancelBtnPress"
					visible="{= ${ui>/OverviewForm/editMode} }"
				/>
				<Button 
					id="ApprovalButtonId" 
					text="Approvals" 
					icon="sap-icon://validate" 
					press="onApprovalsPress" 
					visible="{= !${ui>/OverviewForm/editMode}}"
					enabled="{= ${ui>/enableApprovalButton} }"
				/>

				<MenuButton id="idDownloadAttachmentButton" text="Download" useDefaultActionOnly="false" visible="{= !${ui>/OverviewForm/editMode} &amp;&amp; (${st>/SelectedCountry} !== 'PK' || ${accessControl>/standardtenderAccess/OverviewDownload}) }" class = "sapUiSmallMarginTop" enabled = "{= ${em>/Detail/OverviewTab/enableDownload}}">
					<menu>
						<Menu itemSelected="onMenuAction">
							<MenuItem id="btnWordDownload" text="Word" icon="sap-icon://doc-attachment" visible="{= ${ui>/WordTemplateCountry/length} > 0}" items="{ui>/WordTemplateCountry}">
								<items>
									<MenuItem text="{ui>name}" press=".onDownloadWord"/>
								</items>
							</MenuItem>
							<MenuItem id="btnPDFDownload" text="Email PDF" icon="sap-icon://pdf-attachment" visible="{= ${ui>/WordTemplateCountry/length} > 0 &amp;&amp; ${st>/SelectedCountry} === 'PK'}" items="{ui>/WordTemplateCountry}">
								<items>
									<MenuItem text="{ui>name}" press=".onDownloadPdf"/>
								</items>
							</MenuItem>
							<MenuItem id="btnExcelDownload" text="Excel" icon="sap-icon://excel-attachment" visible="{= ${ui>/ExcelTemplateCountry/length} > 0}" items="{ui>/ExcelTemplateCountry}">
								<items>
									<MenuItem text="{ui>name}" press=".onDownloadExcel"/>
								</items>
							</MenuItem>
						</Menu>
					</menu>
				</MenuButton>

				<Button
					id="btnSubmitQuotation"
					text="{i18n>SubmitQuotation}"
					icon="sap-icon://sys-enter"
					press=".onSubmitQuotation"
					enabled = "{= ${em>/Detail/OverviewTab/enableSetAsSubmited}}"
					visible="{= !${ui>/OverviewForm/editMode}}"
				/>
					
				</Toolbar>
			</form:toolbar>
			<form:layout>
				<form:ResponsiveGridLayout
					labelSpanXL="{template>layout/labelSpanXL}"
					labelSpanL="{template>layout/labelSpanL}"
					labelSpanM="{template>layout/labelSpanM}"
					labelSpanS="{template>layout/labelSpanS}"
					adjustLabelSpan="{template>layout/adjustLabelSpan}"
					emptySpanXL="{template>layout/emptySpanXL}"
					emptySpanL="{template>layout/emptySpanL}"
					emptySpanM="{template>layout/emptySpanM}"
					emptySpanS="{template>layout/emptySpanS}"
					columnsXL="{template>layout/columnsXL}"
					columnsL="{template>layout/columnsL}"
					columnsM="{template>layout/columnsM}"
					singleContainerFullSize="{template>layout/singleContainerFullSize}" />
			</form:layout>
			<form:formContainers>
				<form:FormContainer title="" formElements="{path:'template>formElements',templateShareable:true}">
					<form:formElements>
						<form:FormElement visible="{template>visible}" label="{= ${appView>/language} === 'en' ? ${template>label} : ${template>labelLocale} !== null ? ${template>labelLocale} : ${template>label}}" fields="{path:'template>controls',factory:'.fieldsFactory',templateShareable:true}">
							<!-- <form:fields>
								<Input value="{template>control/type}"/>
							</form:fields> -->
						</form:FormElement>
					</form:formElements>
				</form:FormContainer>
			</form:formContainers>
		</form:Form>
	

			<Table 
				id="idProductInformationTable" 
				mode="SingleSelectMaster"
				items = "{path: '/OfferProductValidation', templateShareable: true}"
			>
			<headerToolbar>
			<OverflowToolbar>
					<Title text="{i18n>ProductInformation}" />
			</OverflowToolbar>
			</headerToolbar>
				<columns>
					<Column>
						<Label text="{i18n>Product}" wrapping="true"/>
					</Column>
					<Column>
						<Label text="{i18n>Qty}" wrapping="true"/>
					</Column>
					<Column>
						<Label text="{i18n>UnitPrice}" wrapping="true"/>
					</Column>
					<Column>
						<Label text="{i18n>PackPrice}" wrapping="true"/>
					</Column>
					<Column>
						<Label text="{i18n>NetPriceperUnit}" wrapping="true"/>
					</Column>
					<Column>
						<Label text="{i18n>NetPriceperPack}" wrapping="true"/>
					</Column>
					<Column>
						<Label text="{i18n>TotalAmount}" wrapping="true"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{PRODUCTNAME}"/>	
							<Text 
								text ="{
									path: 'REQUESTED_QUANTITY',
									type: 'sap.ui.model.type.Integer',
									formatOptions: { 
										maxFractionDigits: 0,
										minFractionDigits: 0, 
										groupingEnabled: true, 
										groupingSeparator: ','
									}
								} {UNIT}"							
							/>
							<ObjectStatus 
								text="{
									parts: [
										{path: 'REQ_PRICE_UNIT_OFFER_CURRENCY'},
										{path: 'CURRENCY'},
										{path: 'Region'},
										{path: 'COUNTRY_CODE'}
									],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
								}"
							/>	
							<ObjectStatus 
								text="{
									parts: [
										{path: 'REQ_PRICE_PACK_OFFER_CURRENCY'},
										{path: 'CURRENCY'},
										{path: 'Region'},
										{path: 'COUNTRY_CODE'}
									],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
								}"
							/>
							<Text 
								text = "{
									parts: ['NET_PRICE_UNIT_OFFER_CURRENCY', 'CURRENCY', 'Region','COUNTRY_CODE'],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
								}"					
							/>
							<Text 
								text = "{
									parts: ['NET_PRICE_PACK_OFFER_CURRENCY', 'CURRENCY', 'Region','COUNTRY_CODE'],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
								}"						
							/>
							<ObjectStatus 
								text = "{
									parts: ['NET_SALES_OFFER_CURRENCY', 'CURRENCY', 'Region','COUNTRY_CODE'],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
								}"						
							/>					
						</cells>
					</ColumnListItem>
				</items>
			</Table>

			<Table 
				id="idProductFOCInformationTable" 
				mode="SingleSelectMaster"
				items="{path : 'ui>/StandardTenderFOCInformation'}"
			>
			<headerToolbar>
			<OverflowToolbar>
					<Title text="{i18n>FOCInformation}" />
			</OverflowToolbar>
			</headerToolbar>
				<columns>
					<Column>
						<Label text="{i18n>MainProduct}" wrapping="true"/>
					</Column>
					<Column>
						<Label text="{i18n>FOCProduct}" wrapping="true"/>
					</Column>
					<Column>
						<Label text="{i18n>AddedIncluded}" wrapping="true"/>
					</Column>
					<Column>
						<Label text="{i18n>Type}" wrapping="true"/>
					</Column>
					<Column>
						<Label text="{i18n>Bonus}" wrapping="true"/>
					</Column>
					<Column>
						<Label text="{i18n>MinOrderQty}" wrapping="true"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{ui>MainProductName}"/>	
							<Text text="{ui>FOCProductName}"/>
							<Text text="{ui>ADD_INCLUDE}"/>
							<Text text="{ui>Type}"/>
							<Text text="{ui>Bonus}"/>
							<Text 
								text ="{
									path: 'ui>MinOrderQty',
									type: 'sap.ui.model.type.Integer',
									formatOptions: { 
										maxFractionDigits: 0,
										minFractionDigits: 0, 
										groupingEnabled: true, 
										groupingSeparator: ','
									}
								}"							
							/>				
						</cells>
					</ColumnListItem>
				</items>
			</Table>
</mvc:View>