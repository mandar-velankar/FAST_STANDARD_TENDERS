<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core" 
	xmlns:form="sap.ui.layout.form" 
	xmlns:tree="sap.ui.table"
>   
	

    <VBox >
		<tree:Table 
			id="idSalesDetailTable"
			rows="{/SalesReportView}"
			selectionMode="None"
			visibleRowCount="10"
		>
			<tree:columns>
				<tree:Column sortProperty="OfferID">
					<Label text="OfferID" wrapping="true"/>
					<tree:template>
						<Text text="{OfferID}" />
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="DistributorName">
					<Label text="Wholesaler Name" wrapping="true"/>
					<tree:template>
						<Text text="{DistributorName}" />
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="MainInstituteName">
					<Label text="Institute" wrapping="true"/>
					<tree:template>
						<Text text="{MainInstituteName}" />
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="External_InstituteId">
					<Label text="Customer ID" wrapping="true"/>
					<tree:template>
						<Text text="{External_InstituteId}" />
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="FilePeriod">
					<Label text="Date" wrapping="true"/>
					<tree:template>
						<Text text="{
							path: 'FilePeriod',
							type: 'sap.ui.model.type.Date',
							formatOptions: { 
								pattern: 'dd-MM-yyyy'
							}
						}" />
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="BrandName">
					<Label text="Brand" wrapping="true"/>
					<tree:template>
						<Text text="{BrandName}" />
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="PRODUCTPACKNAME">
					<Label text="Product" wrapping="true"/>
					<tree:template>
						<Text text="{PRODUCTPACKNAME}" />
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="EANNumber">
					<Label text="EAN Number" wrapping="true"/>
					<tree:template>
						<Text text="{EANNumber}" />
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="Quantity">
					<Label text="Quantity [Units]" wrapping="true"/>
					<tree:template>
						<Text text="{
							parts: ['Quantity', 'CountryCode'],
							type: 'com.bayer.tender.statenderapp.model.datatypes.CustomNumberType'
						}"/>
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="QuantityMl">
					<Label text="Quantity [ML]" wrapping="true"/>
					<tree:template>
						<Text text="{
							parts: ['QuantityMl', 'CountryCode'],
							type: 'com.bayer.tender.statenderapp.model.datatypes.CustomNumberType'
						}"/>
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="WholesalerPurchasePrice">
					<Label text="List Price" wrapping="true"/>
					<tree:template>
						<Text text="{
							parts: ['WholesalerPurchasePrice', 'Currency','Region', 'CountryCode'],
							type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
						}"/>
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="WholesalerContractPrice">
					<Label text="Special Price" wrapping="true"/>
					<tree:template>
						<Text text="{
							parts: ['WholesalerContractPrice', 'Currency','Region', 'CountryCode'],
							type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
						}"/>
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="WholesalerPurchaseAmount">
					<Label text="Wholesaler Purchased Amount" wrapping="true"/>
					<tree:template>
						<Text text="{
							parts: ['WholesalerPurchaseAmount', 'Currency','Region', 'CountryCode'],
							type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
						}"/>
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="NetSales">
					<Label text="Net Sales" wrapping="true"/>
					<tree:template>
						<Text text="{
							parts: ['NetSales', 'Currency','Region', 'CountryCode'],
							type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
						}"/>
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="RequestedVolume">
					<Label text="Contract Product Volume" wrapping="true"/>
					<tree:template>
						<Text text="{
							parts: ['RequestedVolume', 'CountryCode'],
							type: 'com.bayer.tender.statenderapp.model.datatypes.CustomNumberType'
						}"/>
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="BrandUsedVolume">
					<Label text="Used Brand Volume" wrapping="true"/>
					<tree:template>
						<Text text="{
							parts: ['BrandUsedVolume', 'CountryCode'],
							type: 'com.bayer.tender.statenderapp.model.datatypes.CustomNumberType'
						}"/>
					</tree:template>
				</tree:Column>
				<tree:Column sortProperty="ContractBrandUsage">
					<Label text="Contract Brand Usage" wrapping="true"/>
					<tree:template>
						<Text text="{
							parts: ['ContractBrandUsage', 'CountryCode'],
							type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'
						}"/>
					</tree:template>
				</tree:Column>
			</tree:columns>
		</tree:Table>
	</VBox>

</core:FragmentDefinition>