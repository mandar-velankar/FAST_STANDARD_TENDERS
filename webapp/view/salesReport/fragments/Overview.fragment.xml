<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core" 
	xmlns:form="sap.ui.layout.form" 
    xmlns:tree="sap.ui.table"
>   
    <VBox >
        <tree:Table 
            id="idSalesOverviewTable"
            rows="{
                path: '/OverviewSectionsView',
                events: {
                    dataReceived: '.onOverviewSectionDataReceived'
                }
            }"
            selectionMode="None"   
            >
            <tree:columns>
                <tree:Column sortProperty="BrandName" filterProperty="BrandName">
                    <Label text="BRAND" />
                    <tree:template>
                        <Text text="{BrandName}" />
                    </tree:template>
                </tree:Column>
                <tree:Column sortProperty="MinPrice">
                    <Label text="Minimum Price" />
                    <tree:template>
                        <Text text="{
								parts: ['MinPrice', 'Currency','Region', 'CountryCode'],
								formatter: '.formatValue'
							}"/>
                    </tree:template>
                </tree:Column>
                <tree:Column sortProperty="AvgPrice">
                    <Label text="Average Price" />
                    <tree:template>
                        <Text text="{
								parts: ['AvgPrice', 'Currency','Region', 'CountryCode'],
								formatter: '.formatValue'
							}"/>
                    </tree:template>
                </tree:Column>
                <tree:Column sortProperty="MaxPrice">
                    <Label text="Maximum Price" />
                    <tree:template>
                        <Text text="{
								parts: ['MaxPrice', 'Currency','Region', 'CountryCode'],
								formatter: '.formatValue'
							}"/>
                    </tree:template>
                </tree:Column>
                <tree:Column sortProperty="QuantitySold">
                    <Label text="Quantity Sold" />
                    <tree:template>
                        <Text text="{
								parts: ['QuantitySold', 'CountryCode'],
								type: 'com.bayer.tender.statenderapp.model.datatypes.CustomNumberType'
							}"/>
                    </tree:template>
                </tree:Column>
                <tree:Column sortProperty="TotalSales">
                    <Label text="Total Sales" />
                    <tree:template>
                        <Text text="{
								parts: ['TotalSales', 'Currency','Region', 'CountryCode'],
								formatter: '.formatValue'
							}"/>
                    </tree:template>
                </tree:Column>
            </tree:columns>
        </tree:Table>

	</VBox>

</core:FragmentDefinition>