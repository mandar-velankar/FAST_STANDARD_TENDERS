<mvc:View
	controllerName="com.bayer.tender.statenderapp.controller.Master"
	xmlns="sap.m"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt">

	<f:DynamicPage
		id="masterPage"
		preserveHeaderStateOnScroll="true"
		toggleHeaderOnTitleClick="false">
		
		<!-- DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text ="{= ${st>/SelectedCountry} === 'NL'? 'Price Requests' :'Tenders'}"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>


		<f:content>
			<VBox>
				<OverflowToolbar class="sapFDynamicPageAlignContent">
					<Label
						text="Country"
						labelFor="idSlctCountry"
					/>
					<Select 
						id="idSlctCountry" 
						selectedKey="{st>/SelectedCountry}"
						items="{ 
							path: '/UserCountries', 
							parameters: {
								expand: 'Country'
							},
							sorter: { 
								path: 'Country/CountryName' 
							},
							 events: {
								dataReceived: '.onCountriesReceived'
							}
						}"
						change=".onCountriesReceived"
					>
						<core:Item key="{Country/CountryCode}" text="{Country/CountryName}"/>
					</Select>
					<Label
						text="Brand"
						labelFor="idSlctBrand"
					/>
					<Select 
						id="idSlctBrand" 
						change=".setFilter"
					>
						<!-- items binding see controller -->
						<core:Item key="{BRANDID}" text="{BRANDNAME}"/>
					</Select>
					<Label
						text="Status"
						labelFor="idSlctStatus"
					/>
					<Select 
						id="idSlctStatus" 
						change=".setFilter" 
					>
						<!-- items binding see controller -->
						<core:Item key="{Status}" text="{Status}"/>
					</Select>

					<Label
						text="Product Scope"
						labelFor="idSelectProductScope"
					/>
					<Select 
						id="idSelectProductScope"
						selectedKey="{st>/ProductScope}"
						change='onProductScopesReceived'>
						<core:Item key="{ProductScope}" text="{ProductScope}"/>
					</Select>

					<ToolbarSpacer/>
					<SearchField id="idSearch" search=".setFilter" width="17.5rem"/>
					<Button text ="{= ${st>/SelectedCountry} === 'NL'? 'New Price Request' :'New Tender'}" icon = "sap-icon://add" press=".onOpenCreateTenderDialog"/>
					<Button icon="sap-icon://sort" text="" press=".onOpenViewSettings"/>
					<Button icon="sap-icon://download" text="Download CSV" press=".onDownloadZuelligExtractCSV" visible="{= ${accessControl>/standardtenderAccess/ZuelligExtract}}"/>
					<Select id = "idlanguageChange" change=".onLanguageChange">
						<core:Item key="EN" text="English" />
						<core:Item key="LOCAL" text="Local" />
					</Select>
				</OverflowToolbar>
				<Table id="genericMasterTable" 
					columns="{path:'template>/masterConfig/countryTemplate/template/table/columns'}"
					itemPress=".onSelectionChange"
					class="sapFDynamicPageAlignContent"
					width="auto"
					updateFinished=".onUpdateFinished"
					alternateRowColors="true"
					contextualWidth="Auto" 
					autoPopinMode="true"
					hiddenInPopin="None"
					growing="true"
					growingThreshold="15"
					growingScrollToLoad="false"
					busyIndicatorDelay="0"
					mode="SingleSelectMaster"
				>
					<columns>
						<Column importance="{template>importance}" >
							<Text text="{= ${appView>/language} === 'en' ? ${template>title} : ${template>titleLocale} !== null ? ${template>titleLocale} : ${template>title}}" />
						</Column>
					</columns>
				</Table>
			</VBox>
