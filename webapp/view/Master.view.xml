<mvc:View
	controllerName="com.bayer.tender.statenderapp.controller.Master"
	xmlns="sap.m"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt">

	<f:DynamicPage
		id="masterPage"
		preserveHeaderStateOnScroll="true"
		toggleHeaderOnTitleClick="false">
		
		<!-- DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Tenders"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>


		<f:content>
			<VBox fitContainer="true">
				<OverflowToolbar class="sapFDynamicPageAlignContent">
					<!-- Filter for Country -->
					<Select id="idSlctCountry" forceSelection="true" selectedKey="TH" items="{ path: 'ctr>/countries', sorter: { path: 'countryName' } }"
							change=".setFilter">
							<core:Item key="{ctr>countryCode}" text="{ctr>countryName}"/>
					</Select>

					<!-- Filter for Brand -->
					<Select 
						id="idSlctBrand" 
						forceSelection="true" 
						items="{ 
							path: 'ctr>/countryContractBrands', 
							sorter: { path: 'BrandName' }
						}"
						change="._filterContractsTable"
					>
							<core:Item key="{ctr>BrandID}" text="{ctr>BrandName}"/>
					</Select>

					<!-- Filter for Status -->
					<!--<Select id="idSlctChannel" forceSelection="true" change=".setFilter" visible="true">
						<items>
							<core:Item key="All" text="All"/>
							<core:Item key="Tender" text="Tenders"/>
							<core:Item key="Other" text="Other"/>
						</items>		
					</Select>-->
					<ToolbarSpacer/>
					
					<SearchField id="idSearch" search=".setFilter" width="17.5rem"/>
						<Button icon="sap-icon://add" text="Create New" press=".onAdd"/>
				</OverflowToolbar>
				<Table
					id="list"
					inset="false"
					items="{
						path: '/PT_TMTEND'
					}"
					class="sapFDynamicPageAlignContent"
					width="auto"
					updateFinished=".onUpdateFinished"
					alternateRowColors="true"
					contextualWidth="Auto" 
					popinLayout="Block"
					growing="true"
					growingThreshold="15"
					growingScrollToLoad="false">
					<columns>
						<Column width="6%" visible="{= ${appView>/layout} !== 'TwoColumnsMidExpanded' }">
							<header>
								<ObjectIdentifier title="{i18n>Country}" />
							</header>
						</Column>
						<Column width="10%" demandPopin="true" popinDisplay="Inline" >
							<header>
								<ObjectIdentifier title="{i18n>TenderID}" />
							</header>
						</Column>
						<Column width="12%" minScreenWidth="920px" demandPopin="true" popinDisplay="Inline" visible="{= ${appView>/layout} === 'TwoColumnsMidExpanded' }">
							<header>
								<ObjectIdentifier title="{i18n>TenderName}" />
							</header>
						</Column>
						<Column width="12%" minScreenWidth="920px" demandPopin="true" popinDisplay="Inline">
							<header>
								<ObjectIdentifier title="{i18n>Institute}" />
							</header>
						</Column>
						<Column width="10%" visible="{= ${appView>/layout} !== 'TwoColumnsMidExpanded' }">
							<header>
								<ObjectIdentifier title="{i18n>OfferID}" />
							</header>
						</Column>
						<Column width="12%" minScreenWidth="920px" demandPopin="true" popinDisplay="Inline">
							<header>
								<ObjectIdentifier title="{i18n>value}" />
							</header>
						</Column>
						<Column width="12%" visible="{= ${appView>/layout} !== 'TwoColumnsMidExpanded' }">
							<header>
								<ObjectIdentifier title="{i18n>OfferStatus}" />
							</header>
						</Column>
						<Column width="12%" visible="{= ${appView>/layout} !== 'TwoColumnsMidExpanded' }">
							<ObjectIdentifier title="{i18n>pubcndte}" />
						</Column>
						<Column width="12%" minScreenWidth="920px" demandPopin="true" popinDisplay="Inline">
							<ObjectIdentifier title="{i18n>BidDueDate}" />
						</Column>
						<Column width="12%" minScreenWidth="920px" demandPopin="true" popinDisplay="Inline">
							<ObjectIdentifier title="{i18n>ClosingDate}" />
						</Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onSelectionChange">
							<cells>
								<Text text="{CountryCode}"/>
								<ObjectIdentifier text="{TenderID}"/>
								<Text text="{TenderName}"/>
								<Text text="{InstituteID}"/>
								<Text text="{/Offer/OfferID}"/>
								<Text text="{/CountryCode}"/>
								<Text text="{/CountryCode}"/>
								<Text text="{
									path: 'PublicationDate',
									type: 'sap.ui.model.type.Date',
									formatOptions: {
										pattern: 'yyyy-MM-dd'
									}
								}"/>
								<Text text="{
									path: 'BidDueDate',
									type: 'sap.ui.model.type.Date',
									formatOptions: {
										pattern: 'yyyy-MM-dd'
									}
								}"/>
								<Text text="{/CountryCode}"/>
								<Text text="{/CountryCode}"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>