<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Panel
        expandable="true"
        headerText="Delivery Details"
    >
        <content>
        <Table
            id="idDeliveryTrackingTable"
            items="{path: '/DeliveryTrackingDetailView'}"
            mode="SingleSelectMaster"
            selectionChange=".onSelectDelivery"
            updateFinished=".onUpdateFinished"
        >
            <headerToolbar>
                    <OverflowToolbar>
                        <ToolbarSpacer />
                        <Button
                            icon="sap-icon://add"
                            text="Add"
                            press=".onButtonDeliveryTrackingCreatePress"
                            visible="{= ${ui>/DeliveryTrackingForm/editMode}}"
                        />
                        <Button
                            class="sapUiSmallMarginBegin"
                            icon="sap-icon://edit"
                            text="Edit"
                            press=".onButtonEditDeliveryPress"
                            visible="{= !${ui>/DeliveryTrackingForm/editMode}}"
                        />
                        <Button
                            icon="sap-icon://alert"
                            text="{= ${messages>/deliveryTrackingDetail}.length }"
                            visible="{= ${messages>/deliveryTrackingDetail}.length > 0 &amp;&amp; ${ui>/DeliveryTrackingForm/editMode}}"
                            type="Emphasized"
                            press="onMessagePopoverPress($event, 'deliveryTrackingDetail')"
                        />
                        <Button
                            class="sapUiSmallMarginBegin"
                            icon="sap-icon://save"
                            text="Save"
                            press=".onButtonDeliverySavePress"
                            visible="{= ${ui>/DeliveryTrackingForm/editMode}}"
                        />
                        <Button
                            class="sapUiSmallMarginBegin"
                            icon="sap-icon://decline"
                            text="Cancel"
                            press=".onButtonDeliveryCancelPress"
                            visible="{= ${ui>/DeliveryTrackingForm/editMode}}"
                        />
                    </OverflowToolbar>
                </headerToolbar>
            <columns>
                <Column>
                    <Label
                        text="{i18n>DeliveryTrackingProductInst}"
                        wrapping="true"
                    />
                </Column>
                <Column>
                    <Label
                        text="{i18n>DeliveryTrackingProductReqDeliveryDate}"
                        wrapping="true"
                    />
                </Column>
                <Column>
                    <Label
                        text="{i18n>DeliveryTrackingProductRequestedQty}"
                        wrapping="true"
                    />
                </Column>
                <Column>
                    <Label
                        text="{i18n>DeliveryTrackingProductPaid}"
                        wrapping="true"
                    />
                </Column>
                <Column width="5rem"/>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Select
                            id="idChildInstitutesSelect"
                            items="{path: '/ChildInstitutesView', templateShareable:true}"
                            enabled="{ui>/DeliveryTrackingForm/editMode}"
                            selectedKey="{InstituteID}"
                        >
                            <items>
                                <core:Item
                                    text="{InstituteName}"
                                    key="{InstituteID}"
                                />
                            </items>
                        </Select>
                        <DatePicker
                            enabled="{ui>/DeliveryTrackingForm/editMode}"
                            value="{
                                'path':'RequestedDeliveryDate',
                                'type':'sap.ui.model.type.Date',
                                'formatOptions': {
                                    pattern: 'dd-MM-yyyy',
                                    UTC:true
                                }
                            }"
                        />
                         <Input
                            value="{RequestedQuantity}"
                            enabled="{ui>/DeliveryTrackingForm/editMode}"
                        />
                        <Select
                            enabled="{ui>/DeliveryTrackingForm/editMode}"
                            selectedKey="{PaidOrFree}"
                        >
                            <items>
                                <core:Item
                                    text=""
                                    key=""
                                />
                                <core:Item
                                    text="Paid"
                                    key="Paid"
                                />
                                <core:Item
                                    text="Free"
                                    key="Free"
                                />
                            </items>
                        </Select>                   
                        <Button
                            class="sapUiSmallMarginBegin"
                            icon="sap-icon://delete"
                            press=".onButtonDeleteDeliveryPress"
                            visible="{ui>/DeliveryTrackingForm/editMode}"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <form:Form
                id="idDeliveryTrackingForm"
                editable="true"
                visible="false"
                formContainers="{path:'template>/detailDetailDeliveryTrackingConfig/countryTemplate/template/form/formContainers',templateShareable:true}"
            >
                <!-- <form:title>
                    <core:Title text="{template>title}" />
                </form:title> -->
                <!-- <form:toolbar>
                    <Toolbar>
                        <Title text="Tender and Offer Details" />
                    </Toolbar>
                </form:toolbar> -->
                <form:layout>
                    <form:ResponsiveGridLayout
                        labelSpanXL="{template>layout/labelSpanXL}"
                        labelSpanL="{template>layout/labelSpanL}"
                        labelSpanM="{template>layout/labelSpanM}"
                        labelSpanS="{template>layout/labelSpanS}"
                        adjustLabelSpan="{template>layout/adjustLabelSpan}"
                        emptySpanXL="{template>layout/emptySpanXL}"
                        emptySpanL="{template>layout/emptySpanL}"
                        emptySpanM="{template>layout/emptySpanM}"
                        emptySpanS="{template>layout/emptySpanS}"
                        columnsXL="{template>layout/columnsXL}"
                        columnsL="{template>layout/columnsL}"
                        columnsM="{template>layout/columnsM}"
                        singleContainerFullSize="{template>layout/singleContainerFullSize}"
                    />
                </form:layout>
                <form:formContainers>
                    <form:FormContainer
                        formElements="{path:'template>formElements',templateShareable:true}"
                    >
                        <form:formElements>
                            <form:FormElement
                                visible="{template>visible}"
                                label="{= ${appView>/language} === 'en' ? ${template>label} : ${template>labelLocale} !== null ? ${template>labelLocale} : ${template>label}}"
                                fields="{path:'template>controls',factory:'.fieldsFactory',templateShareable:true}"
                            >
                                <!-- <form:fields>
								<Input value="{template>control/type}"/>
							</form:fields> -->
                            </form:FormElement>
                        </form:formElements>
                    </form:FormContainer>
                </form:formContainers>
            </form:Form>
        </content>
    </Panel>
</core:FragmentDefinition>
