<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Panel
        expandable="true"
        headerText="Delivery Details"
    >
        <content>
        <Table
            id="idDeliveryTrackingTable"
            items="{path: '/DeliveryTrackingDetailView'}"
            mode="SingleSelectMaster"
            selectionChange=".onSelectDelivery"
            updateFinished=".onUpdateFinished"
        >
            <headerToolbar>
                    <OverflowToolbar>
                        <ToolbarSpacer />
                        <Button
                            icon="sap-icon://add"
                            text="Add"
                            press=".onButtonDeliveryTrackingCreatePress"
                            visible="{= ${ui>/DeliveryTrackingForm/editMode}}"
                        />
                        <Button
                            class="sapUiSmallMarginBegin"
                            icon="sap-icon://edit"
                            text="Edit"
                            press=".onButtonEditDeliveryPress"
                            visible="{= !${ui>/DeliveryTrackingForm/editMode}}"
                        />
                        
                        <Button
                            class="sapUiSmallMarginBegin"
                            icon="sap-icon://save"
                            text="Save"
                            press=".onButtonDeliverySavePress"
                            visible="{= ${ui>/DeliveryTrackingForm/editMode}}"
                        />
                        <Button
                            class="sapUiSmallMarginBegin"
                            icon="sap-icon://decline"
                            text="Cancel"
                            press=".onButtonDeliveryCancelPress"
                            visible="{= ${ui>/DeliveryTrackingForm/editMode}}"
                        />
                    </OverflowToolbar>
                </headerToolbar>
            <columns>
                <Column>
                    <Label
                        text="{i18n>DeliveryTrackingProductInst}"
                        wrapping="true"
                    />
                </Column>
                <Column>
                    <Label
                        text="{i18n>DeliveryTrackingProductReqDeliveryDate}"
                        wrapping="true"
                    />
                </Column>
                <Column>
                    <Label
                        text="{i18n>DeliveryTrackingProductRequestedQty}"
                        wrapping="true"
                    />
                </Column>
                <Column>
                    <Label
                        text="{i18n>DeliveryTrackingProductPaid}"
                        wrapping="true"
                    />
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <ComboBox
                            enabled="{ui>/DeliveryTrackingForm/editMode}"
                            selectedKey="{InstituteName}"
                        >
                            <items>
                                <core:Item
                                    text="{InstituteName}"
                                    key="{InstituteName}"
                                />
                            </items>
                        </ComboBox>
                        <DatePicker
                            enabled="{ui>/DeliveryTrackingForm/editMode}"
                            value="{
                                'path':'RequestedDeliveryDate',
                                'type':'sap.ui.model.type.Date',
                                'formatOptions': {
                                    pattern: 'dd-MM-yyyy',
                                    UTC:true
                                }
                            }"
                        />
                         <Input
                            value="{RequestedQuantity}"
                            enabled="{ui>/DeliveryTrackingForm/editMode}"
                        />
                        <ComboBox
                            enabled="{ui>/DeliveryTrackingForm/editMode}"
                            selectedKey="{PaidOrFree}"
                        >
                            <items>
                                <core:Item
                                    text="{PaidOrFree}"
                                    key="{PaidOrFree}"
                                />
                            </items>
                        </ComboBox>                   
                        <Button
                            class="sapUiSmallMarginBegin"
                            icon="sap-icon://delete"
                            press=".onButtonDeleteDeliveryPress"
                            visible="{ui>/DeliveryTrackingForm/editMode}"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        </content>
    </Panel>
</core:FragmentDefinition>
