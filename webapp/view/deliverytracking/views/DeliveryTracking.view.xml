<mvc:View
    controllerName="com.bayer.tender.statenderapp.controller.DeliveryTracking.DeliveryTracking"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns:u="sap.uxap"
>
    <Table
        id="idDeliveryProducts" 
        items = "{
            path: '/DeliveryProductTableView'
        }"
        mode="SingleSelectMaster"
        delete="onDeleteDeliveryProduct"
        selectionChange=".onDeliveryProductPress">
        <columns>
            <Column>
                <Label
                    text="{i18n>DeliveryTrackingProduct}"
                    wrapping="true"
                />
            </Column>
            <Column>
                <Label
                    text="{i18n>DeliveryTrackingAwardedVolume}"
                    wrapping="true"
                />
            </Column>
            <Column>
                <Label
                    text="{i18n>DeliveryTrackingSumDeliveredAmount}"
                    wrapping="true"
                />
            </Column>
            <Column>
                <Label
                    text="{i18n>DeliveryTrackingDelivered}"
                    wrapping="true"
                />
            </Column>
        </columns>
        <items>
            <ColumnListItem press="onDeliveryProductPress" detailPress="onDeliveryProductPress">
                <cells>
                    <Text text="{AwardedProduct}"/>	
                    <Text text="{
                        parts: ['AwardedQty', 'CountryCode', 'Region'], 
                        type: 'com.bayer.tender.statenderapp.model.datatypes.CustomNumberType'
                    }"/>
                    <Text text="{
                        parts: ['SumOfDeliveredAmount', 'CountryCode', 'Region'], 
                        type: 'com.bayer.tender.statenderapp.model.datatypes.CustomNumberType'
                    }"/>	
                    <Text text="{
                        path: 'DeliveredPercentage',
                        type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'
                        }"/>				
                </cells>
            </ColumnListItem>
		</items>
    </Table>
</mvc:View>
