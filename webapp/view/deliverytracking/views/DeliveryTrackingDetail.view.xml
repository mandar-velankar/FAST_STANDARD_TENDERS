<mvc:View
    controllerName="com.bayer.tender.statenderapp.controller.DeliveryTracking.DeliveryTrackingDetail"
    xmlns:m="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns:u="sap.uxap"
>
    <f:DynamicPage
        toggleHeaderOnTitleClick="false"
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <m:FlexBox
                        wrap="Wrap"
                        fitContainer="true"
                        alignItems="Center"
                    >
                        <m:Title
                            text="Delivered Product: {AwardedProduct}"
                            wrapping="true"
                            class="sapUiTinyMarginEnd"
                        />
                    </m:FlexBox>
                </f:heading>
                <f:navigationActions>
                    <m:OverflowToolbarButton
                        type="Transparent"
                        icon="sap-icon://full-screen"
                        press=".handleFullScreen"
                        tooltip="Enter Full Screen Mode"
                        visible="{= !${device>/system/phone} &amp;&amp; !${appView>/actionButtonsInfo/midColumn/fullScreen}}"
                    />
                    <m:OverflowToolbarButton
                        type="Transparent"
                        icon="sap-icon://exit-full-screen"
                        press=".handleFullScreen"
                        tooltip="Exit Full Screen Mode"
                        visible="{= !${device>/system/phone} &amp;&amp; ${appView>/actionButtonsInfo/midColumn/fullScreen}}"
                    />
                    <m:OverflowToolbarButton
                        type="Transparent"
                        icon="sap-icon://decline"
                        press=".handleClose"
                        tooltip="Close column"
                        visible="{= ${detailDetailView>/actionButtonsInfo/endColumn/closeColumn} !== null }"
                    />
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <m:VBox>
				<m:VBox>
					<core:Fragment fragmentName="com.bayer.tender.statenderapp.view.deliverytracking.fragments.DeliveryTrackingTable" type="XML"/>
				</m:VBox>
			</m:VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
