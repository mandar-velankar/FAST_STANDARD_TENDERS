<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:up="sap.uxap" xmlns:form="sap.ui.layout.form" xmlns:u="sap.uxap"
	xmlns:t="sap.ui.table" xmlns:l="sap.ui.layout">
    
    <List id="AwardedProducts"
			  headerText="Products"
			  items="{
				path: '/OfferProducts',
				sorter: {
					path: 'Name'
				}
		}">
		<items>
			<StandardListItem
				type="Active"
				title="{Name}"
				navigated="{
					parts: [
						'settings>/navigatedItem',
						'ProductId'
					],
					formatter: '.isNavigated'
				}"
				press="onPress" />
		</items>
	</List>
</core:FragmentDefinition>