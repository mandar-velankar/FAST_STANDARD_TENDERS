<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:up="sap.uxap" xmlns:form="sap.ui.layout.form" xmlns:u="sap.uxap"
	xmlns:t="sap.ui.table" xmlns:l="sap.ui.layout">
<Table
        id="lineItemsList"
        width="auto"
        items="{Offer}"
        updateFinished=".onListUpdateFinished"
        noDataText="{i18n>detailLineItemTableNoDataText}"
        busyIndicatorDelay="{detailView>/lineItemTableDelay}">
        <headerToolbar>
            <Toolbar>
                <Title
                    id="lineItemsTitle"
                    text="{detailView>/lineItemListTitle}"
                    titleStyle="H3"
                    level="H3"/>
            </Toolbar>
        </headerToolbar>
        <columns>
            <Column>
                <Text text="{i18n>detailLineItemTableIDColumn}"/>
            </Column>
            <Column
                minScreenWidth="Tablet"
                demandPopin="true"
                hAlign="End">
                <Text text="{i18n>detailLineItemTableUnitNumberColumn}"/>
            </Column>
        </columns>
        <items>
            <ColumnListItem>
                <cells>
                    <ObjectIdentifier
                        title="{OfferID}"
                        text="{OfferID}"/>
                    <ObjectNumber
                        number="{
                            path: 'ContinuationOfferNo',
                            formatter: '.formatter.currencyValue'
                        }"
                        unit="{DistributorID}"/>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</core:FragmentDefinition>