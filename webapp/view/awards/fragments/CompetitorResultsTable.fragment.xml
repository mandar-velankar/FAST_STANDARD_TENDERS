<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.ui.layout.form"
>
    <Panel
        expandable="true"
        headerText="Competitor Result"
    >
        <content>
            <t:TreeTable
                id="idCompetitorResultTable"
                rows = "{path: 'st>/Competitors'}"
                selectionMode="Single"
                enableSelectAll="false"
                ariaLabelledBy="title"
                rowSelectionChange=".onRowSelectionChange"
            >
                <t:extension>
                    <OverflowToolbar>
                        <content>
                            <ToolbarSpacer />
                            <Button
                                icon="sap-icon://add"
                                press=".onButtonCompetitorResultsCreatePress"
                            />
                        </content>
                    </OverflowToolbar>
                </t:extension>
                <t:columns>
                    <t:Column>
                        <Label
                            text="{i18n>CompetitorCompany}"
                            wrapping="true"
                        />
                        <t:template>
                            <VBox >
                                <ComboBox selectedKey="{st>AWARDEDCOMPANY}" items = "{/MasterCompetitors}">
                                <items>
                                    <core:Item text = "{CompetitorCompany}" key = "{CompetitorCompany}"/>
                                </items>
                            </ComboBox>
                            </VBox>
                        </t:template>
                    </t:Column>
                    <t:Column>
                        <Label
                            text="{i18n>CompetitorProduct}"
                            wrapping="true"
                        />
                        <t:template>
                            <VBox>
                                <ComboBox selectedKey="{st>AWARDEDPRODUCT}" items = "{/MasterCompetitors}">
                                    <items>
                                        <core:Item text = "{CompetitorProduct}" key = "{CompetitorProduct}"/>
                                    </items>
                                </ComboBox>
                            </VBox>
                        </t:template>
                    </t:Column>
                    <t:Column>
                        <Label
                            text="{i18n>CompetitorOutcome}"
                            wrapping="true"
                        />
                        <t:template>
                            <ComboBox selectedKey="{st>OUTCOME}" items = "{/MasterCountryOutComes}">
                                <items>
                                    <core:Item text = "{Outcome}" key = "{Outcome}"/>
                                </items>
                            </ComboBox>
                        </t:template>
                    </t:Column>
                    <t:Column>
                        <Label
                            text="{i18n>CompetitorPrice}"
                            wrapping="true"
                        />
                        <t:template>
                            <Input value="{st>AWARDEDPRICE}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="10rem">
                        <t:template>
                            <HBox>
                                <Button
                                    class = "sapUiSmallMarginBegin"
                                    icon="sap-icon://edit"
                                    text="Edit"
                                    press=".onButtonEditCompetitorPress"
                                />
                                <Button 
                                    class = "sapUiSmallMarginBegin"
                                    icon="sap-icon://delete" 
                                    press=".onButtonDeleteCompetitorPress" 
                                />
                            </HBox>
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:TreeTable>
        </content>
    </Panel>
</core:FragmentDefinition>
