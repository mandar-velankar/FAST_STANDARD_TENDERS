<core:FragmentDefinition
    xmlns:m="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <m:Panel
        expandable="true"
        headerText="Award Details"
    >
        <form:Form
            id="idAwardedProductsDetailForm"
            editable="true"
            formContainers="{path:'template>/detailDetailAwardedProductConfig/countryTemplate/template/form/formContainers',templateShareable:true}"
        >
            <!-- <form:title>
								<core:Title text="{template>title}" />
							</form:title> -->
            <form:toolbar>
                <m:Toolbar>
                    <m:ToolbarSpacer />
                    <m:Button
                        id="idAwardProductEditbtn"
                        icon="sap-icon://edit"
                        text="Edit"
                        press=".onButtonAwardDetailFormEditPress"
                        visible="{= !${ui>/AwardedProductForm/editMode} }"
                        enabled = "{= ${em>/AwardedProductDetail/AwardDetail/editMode}}"
                    />
                    <m:Button
                        icon="sap-icon://alert"
                        text="{= ${messages>/awardedProduct}.length }"
                        visible="{= ${messages>/awardedProduct}.length > 0 &amp;&amp; ${ui>/AwardedProductForm/editMode}}"
                        type="Emphasized"
                        press="onMessagePopoverPress($event, 'awardedProduct')"
                    />
                    <m:Button
                        id="idOfferDetailFormSaveBtn"
                        icon="sap-icon://save"
                        text="Save"
                        press=".onButtonAwardProductDetailFormSavePress"
                        visible="{= ${ui>/AwardedProductForm/editMode} }"
                    />
                    <m:Button
                        id="idOfferDetailFormCancelBtn"
                        icon="sap-icon://decline"
                        text="Cancel"
                        press=".onButtonAwardProductDetailFormCancelPress"
                        visible="{= ${ui>/AwardedProductForm/editMode} }"
                    />
                </m:Toolbar>
            </form:toolbar>
            <form:layout>
                <form:ResponsiveGridLayout
                    labelSpanXL="{template>layout/labelSpanXL}"
                    labelSpanL="{template>layout/labelSpanL}"
                    labelSpanM="{template>layout/labelSpanM}"
                    labelSpanS="{template>layout/labelSpanS}"
                    adjustLabelSpan="{template>layout/adjustLabelSpan}"
                    emptySpanXL="{template>layout/emptySpanXL}"
                    emptySpanL="{template>layout/emptySpanL}"
                    emptySpanM="{template>layout/emptySpanM}"
                    emptySpanS="{template>layout/emptySpanS}"
                    columnsXL="{template>layout/columnsXL}"
                    columnsL="{template>layout/columnsL}"
                    columnsM="{template>layout/columnsM}"
                    singleContainerFullSize="{template>layout/singleContainerFullSize}"
                />
            </form:layout>
            <form:formContainers>
                <form:FormContainer
                    formElements="{path:'template>formElements',templateShareable:true}"
                >
                    <form:formElements>
                        <form:FormElement
                            label="{template>label}"
                            fields="{path:'template>controls',factory:'.fieldsFactory',templateShareable:true}"
                        />
                    </form:formElements>
                </form:FormContainer>
            </form:formContainers>
        </form:Form>
    </m:Panel>
</core:FragmentDefinition>
