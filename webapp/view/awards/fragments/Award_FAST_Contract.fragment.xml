<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <HBox
        justifyContent="SpaceBetween"
        alignItems="Start"
        wrap="Wrap"
    >
        <!-- LEFT SIDE: Vertically stacked elements -->
        <VBox>
            <!-- Contract Start Date -->
            <HBox alignItems="Center">
                <Label
                    text="{i18n>ContractStartDate}"
                    labelFor="contractStartDate"
                    width = "10rem"
                    visible="{= ${st>/SelectedCountry} === 'ES'}"
                />
                <DatePicker
                    id="contractStartDate"
                    value="{
                        path :'st>/ContractStartDate', 
                        type: 'sap.ui.model.type.Date', 
                        formatOptions: { pattern: 'dd.MM.yyyy', UTC: true }
                    }"
                    change=".onContractDateChange"
                    width="10rem"
                    enabled="{= ${em>/AwardedProductDetail/AwardDetail/editMode} &amp;&amp; ${st>/SelectedTender/Classification} === 'Tender' &amp;&amp; !${st>/fastCCMContractId}}"
                    visible="{= ${st>/SelectedCountry} === 'ES'}"
                    minDate="{= ${st>/SelectedTender/Classification} === 'Tender'
                        ? null
                        : ${st>/ContractMngtDateConstraints/minDate} }"
                    maxDate="{ui>/maxDate}"
                />
            </HBox>

            <!-- Contract End Date -->
            <HBox alignItems="Center">
                <Label
                    text="{i18n>ContractEndDate}"
                    labelFor="contractEndDate"
                    width = "10rem"
                    visible="{= ${st>/SelectedCountry} === 'ES'}"
                />
                <DatePicker
                    id="contractEndDate"
                    value="{
                        path :'st>/ContractEndDate', 
                        type: 'sap.ui.model.type.Date', 
                        formatOptions: { pattern: 'dd.MM.yyyy', UTC: true }
                    }"
                    change=".onContractDateChange"
                    width="10rem"
                    enabled="{= ${em>/AwardedProductDetail/AwardDetail/editMode} &amp;&amp; ${st>/SelectedTender/Classification} === 'Tender' &amp;&amp; !${st>/fastCCMContractId}}"
                    visible="{= ${st>/SelectedCountry} === 'ES'}"
                    minDate="{st>/ContractMngtDateConstraints/minDate}"
                    maxDate="{ui>/maxDate}"
                />
            </HBox>
        </VBox>

        <HBox alignItems="Center">
        <!-- RIGHT SIDE: Set All Product Outcome button -->
            <Button
                    visible="{= ${st>/SelectedCountry} === 'ES'}"
                    enabled="{= ${st>/AllAwardProductsHaveOutcome} &amp;&amp; !${st>/AllPriceConditionTypesRental} &amp;&amp; !!${st>/ContractStartDate} &amp;&amp; !!${st>/ContractEndDate} &amp;&amp; !${st>/fastCCMContractId}}"
                    press=".onCreateAllFASTContracts"
                    text="{i18n>CreateAllFASTContracts}"
                    class="sapUiTinyMarginEnd"
            />
            <Button
                text="{i18n>GoToFastContract}"
                visible="{= !!${st>/fastCCMContractId} &amp;&amp; ${st>/SelectedCountry} === 'ES'}"
                press=".onGoToFastContract"
                class="sapUiTinyMarginEnd"
            />
            <MenuButton
                    id="idBankGuaranteemenuButton"
                    text="{i18n>BankGuarantee}"
                    visible="{= ${st>/SelectedCountry} === 'ES'}"
                    class="sapUiTinyMarginEnd"
                >
                    <menu>
                        <Menu itemSelected="onBankGuaranteeMenuAction">
                            <MenuItem
                                text="{i18n>final}"
                                icon="{= ${ui>/bankGuaranteeTypes/Final} ? 'sap-icon://accept' : ''}"
                            />
                            <MenuItem
                                text="{i18n>additional}"
                                icon="{= ${ui>/bankGuaranteeTypes/Additional} ? 'sap-icon://accept' : ''}"
                            />
                        </Menu>
                    </menu>
            </MenuButton>
            <MenuButton
                text="{i18n>SetAllProductWonLost}"
                enabled="{= !${st>/AllAwardProductsHaveOutcome}}"
            >
                <menu>
                    <Menu itemSelected="onMenuSetAllProductWonLostItemSelected">
                        <MenuItem text="Won" />
                        <MenuItem text="Lost" />
                    </Menu>
                </menu>
            </MenuButton>
        </HBox>
    </HBox>
</core:FragmentDefinition>