<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core">
    <TableSelectDialog
		id="idAwardedInstituteGroupDialog"
		contentWidth="250px"
		noDataText="No Institutes Group were found"
		title="{i18n>InstitutesInGroup}"
		search=".handleAwardedInstituteGroupValueHelpSearch"
		liveChange=".handleAwardedInstituteGroupValueHelpSearch"
		confirm=".handleAwardedInstituteGroupHelpConfirm"
		multiSelect="true"
		cancel=".handleAwardedInstituteGroupHelpCancelPress"
		items="{
			path: '/InstitutesInGroup',
			sorter: {path: 'InstituteName'}
		}">
		<columns>
			<Column>
				<Text text="Institute Name"/>
			</Column>
		</columns>
		<items>
			<ColumnListItem type="Active">
				<cells>
					<Text text="{InstituteName}"/>
				</cells>
			</ColumnListItem>
		</items>
	</TableSelectDialog>
</core:FragmentDefinition>