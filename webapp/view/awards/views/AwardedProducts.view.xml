<mvc:View controllerName="com.bayer.tender.statenderapp.controller.AwardedProducts.AwardedProducts" 
	xmlns="sap.m"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt">

	<!--<f:DynamicPage id="idAwardedProducts" toggleHeaderOnTitleClick="false">
		<f:content>-->
			<Panel >
				<core:Fragment fragmentName="com.bayer.tender.statenderapp.view.awards.fragments.Award_FAST_Contract" type="XML"/>
			</Panel>
			<Table 
				id="idAwardedProducts" 
				items = "{
					path: '/AwardedProducts'
				}"
				mode="SingleSelectMaster"
				delete="onDeleteAwardedProduct"
				selectionChange=".onAwardedProductPress">
				<columns>
					<Column >
						<Label text="{i18n>Product}" wrapping="true"/>
					</Column>
					<Column >
						<Label text="{i18n>Outcome}" wrapping="true"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem press="onAwardedProductPress" detailPress="onAwardedProductPress">
						<cells>
							<Text text="{AwardedProduct}"/>	
							<Text text="{Outcome}"/>					
						</cells>
					</ColumnListItem>
				</items>
			</Table>
			
		<!--</f:content>
	</f:DynamicPage>-->
</mvc:View>