<mvc:View controllerName="com.bayer.tender.statenderapp.controller.BasicInformation.BasicInformation" 
	xmlns="sap.m"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt">

	
	<VBox>
		<form:Form
			id="idTenderForm"
			editable="true"
			formContainers="{path:'template>xmlView/formByName/TenderForm/formContainers',templateShareable:true}">
			<form:title>
				<core:Title text="{template>title}" />
			</form:title>
			<form:layout>
				<form:ResponsiveGridLayout
					labelSpanXL="{template>layout/labelSpanXL}"
					labelSpanL="{template>layout/labelSpanL}"
					labelSpanM="{template>layout/labelSpanM}"
					labelSpanS="{template>layout/labelSpanS}"
					adjustLabelSpan="{template>layout/adjustLabelSpan}"
					emptySpanXL="{template>layout/emptySpanXL}"
					emptySpanL="{template>layout/emptySpanL}"
					emptySpanM="{template>layout/emptySpanM}"
					emptySpanS="{template>layout/emptySpanS}"
					columnsXL="{template>layout/columnsXL}"
					columnsL="{template>layout/columnsL}"
					columnsM="{template>layout/columnsM}"
					singleContainerFullSize="{template>layout/singleContainerFullSize}" />
			</form:layout>
			<form:formContainers>
				<form:FormContainer title="{template>title}" formElements="{path:'template>formElements',templateShareable:true}">
					<form:formElements>
						<form:FormElement visible="{= ${template>label} !== 'ID'}" label="{template>label}" fields="{path:'template>controls',factory:'.fieldsFactory',templateShareable:true}">
							<!-- <form:fields>
								<Input value="{template>control/type}"/>
							</form:fields> -->
						</form:FormElement>
					</form:formElements>
				</form:FormContainer>
			</form:formContainers>
		</form:Form>
	</VBox>
	<VBox class='sapUiMediumMargin'>
		<Table id="awardCriteriaId" 
			columns="{path:'template>xmlView/tableByName/AwardCriteriaTable/columns'}"
			class="sapFDynamicPageAlignContent"
			width="auto"
		>
			<headerToolbar>
				<OverflowToolbar>
					<content>
						<Title text="{path:'template>xmlView/tableByName/AwardCriteriaTable/title'}" level="H2"/>
						<ToolbarSpacer />
					</content>
				</OverflowToolbar>
			</headerToolbar>
			<columns>
				<Column>
					<Text text="{template>title}" />
				</Column>
			</columns>
		</Table>
	</VBox>	
	

</mvc:View>