<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core" 
	xmlns:up="sap.uxap" 
	xmlns:form="sap.ui.layout.form" 
	xmlns:u="sap.uxap"
	xmlns:t="sap.ui.table" 
	xmlns:l="sap.ui.layout"
	xmlns:mvc="sap.ui.core.mvc">

<Dialog id = "idCreateTenderDialog" title="{= ${st>/SelectedCountry} === 'NL'? ${i18n>NLNewTender} : ${i18n>NewTender}}" contentWidth="1400px" contentHeight="600px" resizable="true" draggable="true" >
		<content>
			<core:Fragment fragmentName="com.bayer.tender.statenderapp.view.tender.fragments.TenderForm" type="XML"/>
        </content>

        <buttons>
			<Button
				icon="sap-icon://alert"
				text="{= ${messages>/newTenderMsg}.length }"
				visible="{= ${messages>/newTenderMsg}.length > 0 }"
				type="Emphasized"
				press="onMessagePopoverPress($event, 'newTenderMsg')" 
			/>
            <Button id="addSelectedSOProducts" text="Create" press=".onCreateNewTender"/>
            <Button id="cancelDialog" text="Cancel" press=".onCloseTenderCreationDialog" />
        </buttons>
</Dialog>

</core:FragmentDefinition>