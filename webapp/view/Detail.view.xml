<mvc:View
	controllerName="com.bayer.tender.statenderapp.controller.Detail"
	xmlns="sap.m"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt">
	<f:DynamicPage id="detailPage" showFooter="{comp>/detailEditMode}"
		busy="{detailView>/busy}"
		busyIndicatorDelay="{detailView>/delay}"
			stickySubheaderProvider="detailTabBar"
			class="sapUiNoContentPadding" >
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{TenderName}" level="H2"/>
				</f:heading>
				<f:navigationActions>
					<!--<Button
							text="Edit"
							icon="sap-icon://{= ${appView>/editmode}?'display':'edit'}"
							type="{= ${appView>/editmode}?'Transparent':'Emphasized'}"
							press=".onEdit" />-->
					<Button
							icon="sap-icon://full-screen"
							type="Transparent"
							visible="{= !${device>/system/phone} &amp;&amp; !${appView>/actionButtonsInfo/midColumn/fullScreen}}"
							press=".toggleFullScreen" />
					<Button
							icon="sap-icon://exit-full-screen"
							type="Transparent"
							visible="{= !${device>/system/phone} &amp;&amp; ${appView>/actionButtonsInfo/midColumn/fullScreen}}"
							press=".toggleFullScreen" />
					<Button
							icon="sap-icon://decline"
							type="Transparent" 
							press=".onCloseDetailPress"/>
				</f:navigationActions>

				<!-- ACTIONS -->
				<f:actions>
					<Button id="deleteTenderButtonId" icon="sap-icon://delete" text="Delete" type="Reject" press="onDeleteTenderPress" enabled="true" />
					<Button id="folderButtonId" icon="sap-icon://browse-folder" text="Documents" type="Emphasized" press="._onFolderButtonPress" visible="{= ${fastData>FoldersCreated} === 1}"/>
					<Button id="refreshButtonId" icon="sap-icon://refresh" type="Emphasized" press="onRefresh" enabled="true"/>
					<!--<m:Button id="editButtonId" text="Edit" type="Emphasized" press=".onEditButtonPress" enabled="true"/>-->
					<Button id="editButtonId" text="Edit" type="Emphasized" press=".onEditButtonPress" enabled="true"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader >
				<FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">

					<!-- INSTITUTE INFO -->
					<VBox justifyContent="Center" class="sapUiSmallMarginEnd">
						<Label text="{i18n>Institute}"/>
						<Text id="idhdrInstNme" text="Dubai Health Authority (DHA)"/>
						<Text id="idhdrInstID" text="{InstituteID}" visible="false"/>
					</VBox>
					
					<!-- SELECTED TENDER INFO -->
					<VBox justifyContent="Center" class="sapUiSmallMarginEnd">
						<Label text="{i18n>TenderName}"/>
						<Text id="idHdrTndrNme" text="{TenderName}"/>
					</VBox>
					
					<!-- SELECTED OFFER INFO -->
					<VBox justifyContent="Center" class="sapUiSmallMarginEnd">
						<Label text="{i18n>OfferID}"/>
						<Text  text="{OfferID}"/>
					</VBox>

					<!-- SELECTED PRODUCT INFO -->
					<VBox justifyContent="Center" class="sapUiSmallMarginEnd">
						<Label text="{i18n>productnme}"/>
						<Text text="No product selected"/>
					</VBox>	
				
				</FlexBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>	
			<IconTabBar id="detailTabBar" class="sapUiResponsiveContentPadding" items="{template>/detailConfig/countryTemplate/template/tabs}">
				<items>
					<IconTabFilter text="{template>title}"  content="{path:'template>forms'}" >
						<form:Form
							editable="true"
							formContainers="{path:'template>formContainers'}">
							<form:title>
								<core:Title text="{template>title}" />
							</form:title>
							<form:layout>
								<form:ResponsiveGridLayout
									labelSpanXL="{template>layout/labelSpanXL}"
									labelSpanL="{template>layout/labelSpanL}"
									labelSpanM="{template>layout/labelSpanM}"
									labelSpanS="{template>layout/labelSpanS}"
									adjustLabelSpan="{template>layout/adjustLabelSpan}"
									emptySpanXL="{template>layout/emptySpanXL}"
									emptySpanL="{template>layout/emptySpanL}"
									emptySpanM="{template>layout/emptySpanM}"
									emptySpanS="{template>layout/emptySpanS}"
									columnsXL="{template>layout/columnsXL}"
									columnsL="{template>layout/columnsL}"
									columnsM="{template>layout/columnsM}"
									singleContainerFullSize="{template>layout/singleContainerFullSize}" />
							</form:layout>
							<form:formContainers>
								<form:FormContainer title="{template>title}" formElements="{path:'template>formElements'}">
									<form:formElements>
										<form:FormElement label="{template>label}" fields="{path:'template>controls',factory:'.fieldsFactory'}">
											<!-- <form:fields>
												<Input value="{template>control/type}"/>
											</form:fields> -->
										</form:FormElement>
									</form:formElements>
								</form:FormContainer>
							</form:formContainers>
						</form:Form>
					</IconTabFilter>
				</items>
			</IconTabBar>
			<!-- <IconTabBar
				id="detailTabBar"
				expanded="{device>/isNoPhone}"
				class="sapUiResponsiveContentPadding">
				<items>
					<IconTabFilter text="{i18n>tender}" key="tender">
						<Panel visible="{= !${appView>/editmode}}">
							
							<mvc:XMLView id="basicInformationViewId" viewName="com.bayer.tender.statenderapp.view.tender.views.BasicInformation"/>
						</Panel>
					</IconTabFilter>
					<IconTabFilter text="{i18n>offer}" key="offer">
						<mvc:XMLView id="offerProductsViewId" viewName="com.bayer.tender.statenderapp.view.offer.views.OfferProducts" />
					</IconTabFilter>
					<IconTabFilter text="{i18n>overview}" key="overview">
						<mvc:XMLView id="overviewViewId" viewName="com.bayer.tender.statenderapp.view.overview.views.Information"/>
					</IconTabFilter>
					<IconTabFilter text="{i18n>awards}" key="awards">
						<mvc:XMLView id="awardedProductsViewId" viewName="com.bayer.tender.statenderapp.view.awards.views.AwardedProducts"/>
					</IconTabFilter>
				</items>
			</IconTabBar> -->
		</f:content>
	</f:DynamicPage>
</mvc:View>