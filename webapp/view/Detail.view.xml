<mvc:View
	controllerName="com.bayer.tender.statenderapp.controller.Detail"
	xmlns="sap.m"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt">
	<f:DynamicPage id="detailPage" showFooter="{comp>/detailEditMode}"
		busy="{detailView>/busy}"
		busyIndicatorDelay="{detailView>/delay}"
			stickySubheaderProvider="detailTabBar"
			class="sapUiNoContentPadding" >
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{TenderName}" level="H2"/>
				</f:heading>
				<f:navigationActions>
					<!--<Button
							text="Edit"
							icon="sap-icon://{= ${appView>/editmode}?'display':'edit'}"
							type="{= ${appView>/editmode}?'Transparent':'Emphasized'}"
							press=".onEdit" />-->
					<Button
							icon="sap-icon://full-screen"
							type="Transparent"
							visible="{= !${device>/system/phone} &amp;&amp; !${appView>/actionButtonsInfo/midColumn/fullScreen}}"
							press=".toggleFullScreen" />
					<Button
							icon="sap-icon://exit-full-screen"
							type="Transparent"
							visible="{= !${device>/system/phone} &amp;&amp; ${appView>/actionButtonsInfo/midColumn/fullScreen}}"
							press=".toggleFullScreen" />
					<Button
							icon="sap-icon://decline"
							type="Transparent" 
							press=".onCloseDetailPress"/>
				</f:navigationActions>

				<!-- ACTIONS -->
				<f:actions>
					<Button text="Copy Tender" icon="sap-icon://duplicate" press="onCopyTender" enabled="true" />
					<Button id="deleteTenderButtonId" icon="sap-icon://delete" text="Delete" type="Reject" press="onDeleteTenderPress" 
					 enabled="{= ${st>/AllAwardProductsHaveOutcome} &amp;&amp; !${st>/AllPriceConditionTypesRental} &amp;&amp; !!${st>/ContractStartDate} &amp;&amp; !!${st>/ContractEndDate} &amp;&amp; !${st>/fastCCMContractId}}" />
					<Button id="folderButtonId" icon="sap-icon://browse-folder" text="Documents" type="Emphasized" press="._onFolderButtonPress" visible="{= ${fastData>FoldersCreated} === 1}"/>
					<!--<Button id="refreshButtonId" icon="sap-icon://refresh" type="Emphasized" press="onRefresh" enabled="true"/>-->
					<!--<Button id="editButtonId" text="Edit" type="Emphasized" press=".onEditButtonPress" enabled="true"/>-->
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader >
				<FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">

					<!-- INSTITUTE INFO -->
					<VBox justifyContent="Center" class="sapUiSmallMarginEnd">
						<Label text="{i18n>Institute}"/>
						<Text id="idhdrInstNme" text="{InstituteName}"/>
						<Text id="idhdrInstID" text="{InstituteID}" visible="false"/>
					</VBox>
					
					<!-- SELECTED TENDER INFO -->
					<VBox justifyContent="Center" class="sapUiSmallMarginEnd">
						<Label text ="{= ${st>/SelectedCountry} === 'NL'? ${i18n>NLTenderName} :${i18n>TenderName}}"/>
						<Text id="idHdrTndrNme" text="{TenderName}"/>
					</VBox>
					
					<!-- SELECTED OFFER INFO -->
					<VBox justifyContent="Center" class="sapUiSmallMarginEnd">
						<Label text="{i18n>OfferID}"/>
						<Text  text="{OfferID}"/>
					</VBox>				
				</FlexBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>	
			<!-- <IconTabBar id="detailTabBar" class="sapUiResponsiveContentPadding" items="{path: 'template>/detailConfig/countryTemplate/template/tabs', factory: '.tabsFactory',templateShareable: true}" select="onTabSelect" selectedKey = "{st>/selectedTab}"> -->
					<!-- iconTabfilters are generated in tabsFactory implementation in the controller -->
			<!-- </IconTabBar> -->
			<!-- <IconTabBar
				id="detailTabBar"
				expanded="{device>/isNoPhone}"
				class="sapUiResponsiveContentPadding">
				<items>
					<IconTabFilter text="{i18n>tender}" key="tender">
						<Panel visible="{= !${appView>/editmode}}">
							
							<mvc:XMLView id="basicInformationViewId" viewName="com.bayer.tender.statenderapp.view.tender.views.BasicInformation"/>
						</Panel>
					</IconTabFilter>
					<IconTabFilter text="{i18n>offer}" key="offer">
						<mvc:XMLView id="offerProductsViewId" viewName="com.bayer.tender.statenderapp.view.offer.views.OfferProducts" />
					</IconTabFilter>
					<IconTabFilter text="{i18n>overview}" key="overview">
						<mvc:XMLView id="overviewViewId" viewName="com.bayer.tender.statenderapp.view.overview.views.Information"/>
					</IconTabFilter>
					<IconTabFilter text="{i18n>awards}" key="awards">
						<mvc:XMLView id="awardedProductsViewId" viewName="com.bayer.tender.statenderapp.view.awards.views.AwardedProducts"/>
					</IconTabFilter>
				</items>
			</IconTabBar> -->
		</f:content>
	</f:DynamicPage>
</mvc:View>