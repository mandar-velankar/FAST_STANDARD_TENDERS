<mvc:View
	controllerName="com.bayer.tender.statenderapp.controller.Detail"
	xmlns="sap.m"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt">
	<f:DynamicPage id="detailPage" showFooter="{comp>/detailEditMode}"
		busy="{detailView>/busy}"
		busyIndicatorDelay="{detailView>/delay}"
			stickySubheaderProvider="detailTabBar"
			class="sapUiNoContentPadding" >
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{TenderName}" level="H2"/>
				</f:heading>
				<f:navigationActions>
					<Button
							icon="sap-icon://{= ${appView>/editmode}?'display':'edit'}"
							type="{= ${appView>/editmode}?'Transparent':'Emphasized'}"
							press=".onEdit" />
					<Button
							icon="sap-icon://full-screen"
							type="Transparent"
							visible="{= !${device>/system/phone} &amp;&amp; !${appView>/actionButtonsInfo/midColumn/fullScreen}}"
							press=".toggleFullScreen" />
					<Button
							icon="sap-icon://exit-full-screen"
							type="Transparent"
							visible="{= !${device>/system/phone} &amp;&amp; ${appView>/actionButtonsInfo/midColumn/fullScreen}}"
							press=".toggleFullScreen" />
					<Button
							icon="sap-icon://decline"
							type="Transparent" 
							press=".onCloseDetailPress"/>
				</f:navigationActions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader >
					<ObjectAttribute title="{i18n>priceTitle}"/>
					<ObjectNumber
						id="objectHeaderNumber"
						number="{
							path: 'TenderNo',
							formatter: '.formatter.currencyValue'
						}"
						unit="{BidDueDate}"
					/>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>	
			<IconTabBar
				id="detailTabBar"
				expanded="{device>/isNoPhone}"
				class="sapUiResponsiveContentPadding">
				<items>
					<IconTabFilter text="{i18n>tender}" key="tender">
						<Panel visible="{= !${appView>/editmode}}">
							<core:Fragment fragmentName="com.bayer.tender.statenderapp.view.tender.fragments.BasicInformation" type="XML" />
						</Panel>
						<Panel visible="{appView>/editmode}">
							<core:Fragment fragmentName="com.bayer.tender.statenderapp.view.tender.fragments.BasicInformationEdit" type="XML" />
						</Panel>
					</IconTabFilter>
					<IconTabFilter text="{i18n>offer}" key="offer">
						<core:Fragment fragmentName="com.bayer.tender.statenderapp.view.offer.fragments.OfferProducts" type="XML" />
					</IconTabFilter>
					<IconTabFilter text="{i18n>overview}" key="overview">
						<core:Fragment fragmentName="com.bayer.tender.statenderapp.view.overview.fragments.Information" type="XML" />
					</IconTabFilter>
					<IconTabFilter text="{i18n>awards}" key="awards">
						<core:Fragment fragmentName="com.bayer.tender.statenderapp.view.awards.fragments.Information" type="XML" />
					</IconTabFilter>
				</items>
			</IconTabBar>
		</f:content>
	</f:DynamicPage>
</mvc:View>