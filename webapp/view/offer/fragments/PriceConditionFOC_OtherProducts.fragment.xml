<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core">

	<Dialog title="{i18n>PriceConditionFOC_OtherProductsFragment.Products}" >
		<buttons>
			<Button text="Apply" press=".onButtonApplyFocOtherProductsPress" />
			<Button text="Cancel" press=".onButtonCancelFocOtherProductsPress" />
		</buttons>

        <Table 
            id="idFreeGoodsOtherTable"
            items="{
                path: '/FreeGoodsOther',
                groupId: 'PricingForm'
            }"
        >
		<headerToolbar>
			<OverflowToolbar>
				<content>
					<ToolbarSpacer />
                    <Button 
                        icon="sap-icon://add" 
                        press=".onButtonAddFocOtherProductsPress">
                    </Button>
				</content>
			</OverflowToolbar>
		</headerToolbar>
             <columns>
                <Column>
                    <Text text="{i18n>PriceConditionFOC_OtherProductsFragment.Product}"/>
                </Column>
                <Column>
                    <Text text="{i18n>PriceConditionFOC_OtherProductsFragment.FocType}"/>
                </Column>
                <Column>
                    <Text text="{i18n>PriceConditionFOC_OtherProductsFragment.FOCQuantity}"/>
                </Column>
                <Column>
                    <Text text="{i18n>PriceConditionFOC_OtherProductsFragment.FOCStep}"/>
                </Column>    
                <Column>
                    <Text text="{i18n>PriceConditionFOC_OtherProductsFragment.UoM}"/>
                </Column>
                <Column>
                    <Text text="{i18n>PriceConditionFOC_OtherProductsFragment.Action}"/>
                </Column>               
            </columns>
            <ColumnListItem>
                <cells>
                    <Input
                        showValueHelp="true" 
                        valueHelpOnly="true" 
                        valueHelpRequest=".onProductNameInputValueHelpRequest" 
                        value="{ProductPackName}" 
                    />
                    <Select 
                        forceSelection="false" 
                        selectedKey="{FreeGoodsOther_ABS_PCT}"
                    >
                        <core:Item key="ABS" text="Absolute" />
                        <core:Item key="PCT" text="Percentage" />
                        <core:Item key="STP" text="Step" />
                    </Select>
                    <HBox>
                        <Input 
                            type="Number" 
                            value="{path:'FreeGoodsOther'}" 
                            valueState="{FreeGoodsOtherValueState}" 
                            visible="{= 
                                ${FreeGoodsOther_ABS_PCT} === 'ABS' || 
                                ${FreeGoodsOther_ABS_PCT} === 'STP' ? true : false 
                            }"
                        />
                        <Input  
                            value="{
                                path:'FreeGoodsOther',
                                type: '.types.percent'
                            }" 
                            valueState="{FreeGoodsOtherValueState}" 
                            visible="{= 
                                ${FreeGoodsOther_ABS_PCT} === 'PCT' ? true : false 
                            }"
                        /> 
                    </HBox>
                    <Input 
                        type="Number" 
                        value="{path:'FreeGoodsOther_Step'}" 
                        valueState="{FreeGoodsOtherStepValueState}" 
                        enabled="{= ${FreeGoodsOther_ABS_PCT} === 'STP' ? true : false }"
                    />
                    <Text 
                        text="{= 
                            ${FreeGoodsOther_ABS_PCT} === 'ABS' || 
                            ${FreeGoodsOther_ABS_PCT} === 'STP' ? ${UOM}: '%'
                        }">
                    </Text> 
                    <Button 
                        icon="sap-icon://delete" 
                        press=".onButtonDeleteOtherProductPress"
                    />
                </cells>
            </ColumnListItem>
        </Table>
   	</Dialog>	
</core:FragmentDefinition>