<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core">

	<Dialog title="Volume Treshhold" >
		<buttons>
			<Button text="{i18n>Apply}" press=".onApplyDiscountCondition" />
            <Button text="{i18n>Cancel}" press=".onCancelDiscountCondition"/>
		</buttons>

        <Table id="idVolumeTreshold" items="{
                path: '/DiscountConditionView',
                groupId: 'RappelForm'
            }">
            <headerToolbar>
                <OverflowToolbar>
                    <content>
                        <ToolbarSpacer />
						<Button icon="sap-icon://sort" press=".onSortDiscountCondition"/>
                        <Button icon="sap-icon://add" press=".onAddNewDiscountCondition"/>
                    </content>
                </OverflowToolbar>
            </headerToolbar>
            <columns>
                <Column>
                    <Text text="{i18n>Volume}"/>
                </Column>
                <Column>
                    <Text text="{i18n>Discount}"/>
                </Column>
                <Column>
                    <Text text="{i18n>Tax}"/>
                </Column>
                <Column>
                    <Text text="{i18n>NetPriceWithoutTax}"/>
                </Column>    
                <Column>
                    <Text text="{i18n>NetPricewithTax}"/>
                </Column>  
                <Column>
                    <Text text="{i18n>Action}"/>
                </Column>            
            </columns>
            <ColumnListItem>
                <cells>
                    <HBox >
                        <Text text=">=" wrapping="false" class="sapUiSmallMarginTop"/>
                        <Input value="{Volume}" fieldWidth="80%"/>
                    </HBox>
                    <Input value="{
									parts: [ 'Discount', 'CountryCode'],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'
								}" fieldWidth="80%" liveChange=".calculateNetPricesRappel"/>
                    <Input value="{
									parts: [ 'Tax', 'CountryCode'],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'
								}" enabled="false" fieldWidth="80%"/>
                    <Input value="{
									parts: ['NetPriceWithoutTax', 'Currency', 'Region', 'CountryCode'],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
								}" enabled="false" fieldWidth="80%"/>
                    <Input value="{
									parts: ['NetPriceWithTax', 'Currency', 'Region', 'CountryCode'],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
								}" enabled="false" fieldWidth="80%"/>
                    <Button icon="sap-icon://delete" press=".onDeleteDiscountCondition"/>
                </cells>
            </ColumnListItem>
        </Table>
   	</Dialog>	
</core:FragmentDefinition>