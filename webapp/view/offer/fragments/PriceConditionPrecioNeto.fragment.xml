<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:form="sap.ui.layout.form"
>
    <!-- Parent Form -->
    <form:Form id="idPricingForm" editable="true">
        <form:toolbar>
            <Toolbar>
				<ToolbarSpacer />
				<Button
					icon="sap-icon://alert"
					text="{= ${messages>/priceCondPrice}.length }"
					visible="{= ${messages>/priceCondPrice}.length > 0 &amp;&amp; ${ui>/PricingForm/editMode}}"
					type="Emphasized"
					press="onMessagePopoverPress($event, 'priceCondPrice')" 
				/>
				<Button
					icon="sap-icon://edit"
					text="Edit"
					press=".onPricingFormEditBtnPress"
					visible="{= !${ui>/PricingForm/editMode} }"
					enabled="{= ${ui>/PricingForm/hasOfferProductDetailsSaved} &amp;&amp; ${em>/OfferProductDetail/OfferPricingInfo/editMode}}"  
				/>
				<Button
					icon="sap-icon://save"
					text="Save"
					press=".onSpainPrecioNetoPricingFormSaveBtnPress"
					visible="{= ${ui>/PricingForm/hasCurrentPricingReceived} &amp;&amp; ${ui>/PricingForm/editMode}}"
				/>
				<Button
					icon="sap-icon://decline"
					text="Cancel"
					press=".onSpainPricingFormCancelBtnPress"
					visible="{= ${ui>/PricingForm/editMode} }"
				/>
                <Button
					icon="sap-icon://download"
					text="Get Pricing Data"
					press=".onPricingFormGetPricingDataBtnPress"
					visible="{= ${ui>/PricingForm/editMode} }"
				/>
			</Toolbar>
		</form:toolbar>
		<form:layout>
            <form:ResponsiveGridLayout
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="3"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="2" 
                columnsL="2"
                columnsM="1"  
                singleContainerFullSize="false"
            />
        </form:layout>

        <form:formContainers>
            <!-- Container for Current Pricing -->
            <form:FormContainer visible="{st>/hasESCurrentPriceCondition}">
                <form:formElements>
                    <form:FormElement>
                        <form:fields>
                            <core:Fragment id="ESCurrentPricing" fragmentName="com.bayer.tender.statenderapp.view.offer.fragments.ESCurrentPricing" type="XML"/>
                        </form:fields>
                    </form:FormElement>
                </form:formElements>
            </form:FormContainer>

            <!-- Container for New Pricing -->
            <form:FormContainer visible="{st>/hasESCurrentPriceCondition}">
                <form:formElements>
                    <form:FormElement>
                        <form:fields>
                            <core:Fragment id="ESNewPricing" fragmentName="com.bayer.tender.statenderapp.view.offer.fragments.ESNewPricing" type="XML"/>
                        </form:fields>
                    </form:FormElement>
                </form:formElements>
            </form:FormContainer>
        </form:formContainers>
    </form:Form>
</core:FragmentDefinition>