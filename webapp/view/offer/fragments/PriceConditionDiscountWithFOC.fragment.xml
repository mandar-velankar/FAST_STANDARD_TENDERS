<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core" 
	xmlns:form="sap.ui.layout.form" 
>
	<!-- FORM WITH Pricing DATA -->
	<form:Form
		id="idPricingForm"
		editable="true"
	>
		<form:toolbar>
			<Toolbar>
				<Title text="{i18n>PriceConditionDiscountWithFOCFragment.DiscountWithFOC}"/>
				<ToolbarSpacer />
				<Button
					icon="sap-icon://alert"
					text="{= ${messages>/priceCondPrice}.length }"
					visible="{= ${messages>/priceCondPrice}.length > 0 &amp;&amp; ${ui>/PricingForm/editMode}}"
					type="Emphasized"
					press="onMessagePopoverPress($event, 'priceCondPrice')" 
				/>
				<Button
					icon="sap-icon://edit"
					text="Edit"
					press=".onPricingFormEditBtnPress"
					visible="{= !${ui>/PricingForm/editMode} }"
					enabled="{= ${ui>/PricingForm/hasOfferProductDetailsSaved} &amp;&amp; ${em>/OfferProductDetail/OfferPricingInfo/editMode}}"  
				/>
				<Button
					icon="sap-icon://save"
					text="Save"
					press=".onDiscountWithFOCFormSaveBtnPress"
					visible="{= ${ui>/PricingForm/editMode} }"
				/>
				<Button
					icon="sap-icon://decline"
					text="Cancel"
					press=".onDiscountWithFOCFormCancelBtnPress"
					visible="{= ${ui>/PricingForm/editMode} }"
				/>
			</Toolbar>
		</form:toolbar>
		<form:layout>
			<form:ResponsiveGridLayout
				labelSpanXL="3"
				labelSpanL="3"
				labelSpanM="3"
				labelSpanS="12"
				adjustLabelSpan="false"
				emptySpanXL="4"
				emptySpanL="4"
				emptySpanM="4"
				emptySpanS="0"
				columnsXL="1"
				columnsL="1"
				columnsM="1"
				singleContainerFullSize="false" />
		</form:layout>
		<form:formContainers>
			<form:FormContainer>
				<form:formElements>
					<form:FormElement label="{i18n>CurrentBasePrice}" >
						<form:fields>
							<Input value="{
										parts: ['CurrentBasePrice', 'Currency', 'Region'],
										type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
									}"  
									enabled="false"/>
						</form:fields>
					</form:FormElement>
					<form:FormElement label="{i18n>BasePrice}" >
						<form:fields>
							<Input value="{
										parts: ['BasePrice', 'Currency', 'Region'],
										type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
									}"  
									enabled="false"/>
						</form:fields>
					</form:FormElement>
					<form:FormElement label="{= ${CountryCode} === 'PK' ? ${i18n>CustomerDiscount} : ${i18n>Discount}}" >
						<form:fields>
							<Input
								value="{
									path: 'Discount',
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'
								}" 
								liveChange=".onPricingFormLiveChange($event, 'DiscountWithFOC')"
								enabled="{ui>/PricingForm/editMode}"
							/>
						</form:fields>
					</form:FormElement>
					<form:FormElement label="{i18n>OfferPrice}" >
						<form:fields>
							<Input 
								value="{
									parts: ['OfferPrice', 'Currency', 'Region'],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
								}" 
								enabled="false"
							/>
						</form:fields>
					</form:FormElement>
					<form:FormElement label="{i18n>PriceConditionPriceWithFOCFragment.NetOfferPrice}" >
						<form:fields>
							<Input 
								value="{
									parts: ['NetOfferPrice', 'Currency', 'Region'],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
								}" 
								enabled="false"
							/>
						</form:fields>
					</form:FormElement>
					<form:FormElement  label="{= ${CountryCode} === 'PK' ? ${i18n>DistributorDiscount} : ${i18n>Deductions}}" >
						<form:fields>
							<Input
								value="{
									path: 'Deductions',
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'
								}" 
								enabled="{ui>/PricingForm/editMode}"
								liveChange=".onPricingFormLiveChange($event, 'DiscountWithFOC')"
							/>
						</form:fields>
					</form:FormElement>
					<form:FormElement label="{i18n>NetPrice}" >
						<form:fields>
							<Input 
								value="{
									parts: ['NetPrice', 'Currency', 'Region'],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
								}" 
								enabled="false"/>
						</form:fields>
					</form:FormElement>
				</form:formElements>
			</form:FormContainer>
		</form:formContainers>
	</form:Form>

</core:FragmentDefinition>