<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core" 
	xmlns:form="sap.ui.layout.form" 
>
	
	<Label text="Set price by:" class = "sapUiTinyMarginTop sapUiTinyMarginEnd"/>
	<Select
		id = "idSelectedPriceContition"
		items = "{/PriceConditionClassification}"
		selectedKey="{st>/SelectedPriceCondition}"
	>
		<core:Item key="{ConditionType}" text="{ConditionType}"/>
	</Select>

	<!-- FORM WITH Pricing DATA -->
	<form:Form
		id="idPricingForm"
		editable="true"
		formContainers="{
			path:'/PriceConditionPriceView',
			templateShareable:true
		}"
	>
		<form:toolbar>
			<Toolbar>
				<Title text="{i18n>Price}"/>
				<ToolbarSpacer />
				<Button
					icon="sap-icon://alert"
					text="{= ${message>/}.length }"
					visible="{= ${message>/}.length > 0 &amp;&amp; ${ui>/PricingForm/editMode}}"
					type="Emphasized"
					press="onMessagePopoverPress" 
				/>
				<Button
					icon="sap-icon://edit"
					text="Edit"
					press=".onPricingFormEditBtnPress"
					visible="{= !${ui>/PricingForm/editMode} }"
				/>
				<Button
					icon="sap-icon://save"
					text="Save"
					press=".onPricingFormSaveBtnPress"
					visible="{= ${ui>/PricingForm/editMode} }"
				/>
				<Button
					icon="sap-icon://decline"
					text="Cancel"
					press=".onPricingFormCancelBtnPress"
					visible="{= ${ui>/PricingForm/editMode} }"
				/>
			</Toolbar>
		</form:toolbar>
		<form:layout>
			<form:ResponsiveGridLayout
				labelSpanXL="3"
				labelSpanL="3"
				labelSpanM="3"
				labelSpanS="12"
				adjustLabelSpan="false"
				emptySpanXL="4"
				emptySpanL="4"
				emptySpanM="4"
				emptySpanS="0"
				columnsXL="1"
				columnsL="1"
				columnsM="1"
				singleContainerFullSize="false" />
		</form:layout>
		<form:formContainers>
			<form:FormContainer>
				<form:formElements>
					<form:FormElement label="{i18n>BasePrice}" >
						<form:fields>
							<Input value="{Price0}" enabled="false"/>
						</form:fields>
					</form:FormElement>
					<form:FormElement label="{i18n>Discount}" >
						<form:fields>
							<Input
								value="{
									path: 'Level1Discount1',
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'
								}" 
								enabled="false"
							/>
						</form:fields>
					</form:FormElement>
					<form:FormElement label="{i18n>OfferPrice}" >
						<form:fields>
							<Input value="{Price1}" enabled="{ui>/PricingForm/editMode}"/>
						</form:fields>
					</form:FormElement>
					<form:FormElement label="{i18n>Deductions}" >
						<form:fields>
							<Input
								value="{
									path: 'Level2Discount1',
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'
								}" 
								enabled="{ui>/PricingForm/editMode}"
							/>
						</form:fields>
					</form:FormElement>
					<form:FormElement label="{i18n>NetPrice}" >
						<form:fields>
							<Input value="{Price2}" enabled="false"/>
						</form:fields>
					</form:FormElement>
				</form:formElements>
			</form:FormContainer>
		</form:formContainers>
	</form:Form>

</core:FragmentDefinition>