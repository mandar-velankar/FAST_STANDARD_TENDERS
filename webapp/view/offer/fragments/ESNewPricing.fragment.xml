<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <form:Form
        id="idNewPricingForm"
        editable="true"
    >
        <form:title>
            <core:Title text="{ConditionType}" />
        </form:title>
        <form:layout>
            <form:ResponsiveGridLayout
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="3"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="4"
                emptySpanM="4"
                emptySpanS="0"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false"
            />
            
        </form:layout>
        <form:formContainers>
            <form:FormContainer>
                <form:formElements>
                    <form:FormElement label="{i18n>ESPricingFragment.PVL}" visible="{= ${ConditionType} !== 'Rental'}">
                        <form:fields>
                            <Input
                                value="{ parts: ['PVL', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= ${ConditionType} !== 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.ConfidentialDiscount}"
                        visible="{= ${ConfidentialDiscount} > 0 &amp;&amp; ${ConditionType} !== 'Rental'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['ConfidentialDiscount', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'}"
                                enabled="false"
                                visible="{= ${ConfidentialDiscount} > 0 &amp;&amp; ${ConditionType} !== 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.ConfidentialPrice}"
                        visible="{= ${ConfidentialDiscount} > 0 &amp;&amp; ${ConditionType} !== 'Rental'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['ConfidentialPrice', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= ${ConfidentialDiscount} > 0 &amp;&amp; ${ConditionType} !== 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.AdditionalDiscount}"
                        visible="{= ${ConditionType} === 'PrecioNeto'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: [
                                    { path: 'AdditionalDiscount' },
                                    { path: 'CountryCode' },
                                    { value: '3' },
                                    { value: '3' }
                                ], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'}"
                                enabled="false"
                                visible="{= ${ConditionType} === 'PrecioNeto'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.Discount}"
                        visible="{= ${ConditionType} === 'DescuentoComercial' || ${ConditionType} === 'DescuentoEspecial'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: [
                                    { path: 'ESDiscount' },
                                    { path: 'CountryCode' },
                                    { value: '3' },
                                    { value: '3' }
                                ], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'}"
                                enabled="{= ${ui>/PricingForm/editMode} &amp;&amp; ${ConditionType} === 'DescuentoComercial'}"
                                liveChange=".onPricingFormLiveChange($event, 'DescuentoComercial')"
                                visible="{= ${ConditionType} === 'DescuentoComercial' || ${ConditionType} === 'DescuentoEspecial'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.RoyalDecree}"
                        visible="{= ${RoyalDecree} === 'Yes' &amp;&amp; ${ConditionType} !== 'Rental'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: [
                                    { path: 'RoyalDecreePercentage_1' },
                                    { path: 'CountryCode' },
                                    { value: '3' },
                                    { value: '3' }
                                ], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'}"
                                enabled="false"
                                visible="{= ${RoyalDecree} === 'Yes' &amp;&amp; ${ConditionType} !== 'Rental'}"
                            />
                            <Button
                                icon="sap-icon://message-information"
                                type="Transparent"
                                class="sapUiTinyMarginBegin"
                                visible="{= ${IsYP11WithoutRD} &amp;&amp; (!${RoyalDecreePercentage_1} || Number(${RoyalDecreePercentage_1}) === 0) }"
                                press=".onRoyalDecreeInfoPress"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.royalDecreeIncl}"
                        visible="{= ${ConditionType} === 'PrecioNeto' &amp;&amp; (${IsYP11WithoutRD} || ${RoyalDecreePercentage_1} > 0)}"
                    >
                        <form:fields>
                            <CheckBox
                                enabled="{= ${ui>/PricingForm/editMode} &amp;&amp; ${ConditionType} === 'PrecioNeto'}"
                                selected="{RoyalDecreeIncl}"
                                visible="{= ${ConditionType} === 'PrecioNeto' &amp;&amp; (${IsYP11WithoutRD} || ${RoyalDecreePercentage_1} > 0)}"
                                select=".onPricingFormLiveChange($event, 'PrecioNeto')"
                            />
                            <!-- visible="{= ${RoyalDecree} === 'No' &amp;&amp; ${ConditionType} === 'PrecioNeto'}"
                                 select=".onPricingFormLiveChange($event, 'PrecioNeto')" -->
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.RoyalDecreeApplies}"
                        visible="{= ${RoyalDecree} === 'Yes' &amp;&amp; !['Rental','DescuentoEspecial'].includes(${ConditionType})}" 
                    >
                        <form:fields>
                            <Select
                                selectedKey="{= ${RoyalDecree} ? ${RoyalDecree} : 'No'}"
                                enabled="false"
                                visible="{= ${RoyalDecree} === 'Yes' &amp;&amp; !['Rental','DescuentoEspecial'].includes(${ConditionType})}"
                            >
                                <items>
                                    <core:Item
                                        key="No"
                                        text="No"
                                    />
                                    <core:Item
                                        key="Yes"
                                        text="Yes"
                                    />
                                </items>
                            </Select>
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceBeforeRC}"
                        visible="{= ${ConditionType} === 'PrecioNeto'}"
                    >
                        <form:fields>
                            <Input
                                fieldGroupIds="priceInputPrecioNeto"
                                value="{ parts: ['NetPriceWithoutTaxBeforeDeductionRD', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="{= ${ui>/PricingForm/editMode} &amp;&amp; ${ConditionType} === 'PrecioNeto' &amp;&amp; !${ui>/PricingForm/isOverlappingContract} }"
                                liveChange=".onPricingFormLiveChange($event, 'PrecioNeto')"
                                visible="{= ${ConditionType} === 'PrecioNeto'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceBeforeRC}"
                        visible="{= ${ConditionType} === 'DescuentoComercial' || ${ConditionType} === 'PVL'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['NetPriceWithoutTax', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= ${ConditionType} === 'DescuentoComercial' || ${ConditionType} === 'PVL'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.RoyalDecreeValue}"
                        visible="{= ${RoyalDecree} === 'Yes' &amp;&amp; Number(${RoyalDecreeValue}) > 0 &amp;&amp; !['Rental','DescuentoEspecial'].includes(${ConditionType})}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['RoyalDecreeValue', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= ${RoyalDecree} === 'Yes' &amp;&amp; Number(${RoyalDecreeValue}) > 0 &amp;&amp; !['Rental','DescuentoEspecial'].includes(${ConditionType})}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceAfterRC}"
                        visible="{= ${RoyalDecree} === 'Yes' &amp;&amp; ${ConditionType} === 'PrecioNeto'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['NetPriceWithoutTaxAfterDeductionRD', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= ${RoyalDecree} === 'Yes' &amp;&amp; ${ConditionType} === 'PrecioNeto'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.MaximumPrice}"
                        visible="{= ${ConditionType} === 'PrecioNeto' &amp;&amp; ${ui>/Classification} === 'Tender' }"
                    >
                        <form:fields>
                            <Input
                                fieldGroupIds="priceInputPrecioNeto"
                                value="{ parts: ['MaximumPrice', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= ${ConditionType} === 'PrecioNeto' &amp;&amp; ${ui>/Classification} === 'Tender' }"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement label="{i18n>ESPricingFragment.Tax}" visible="{= ${ConditionType} !== 'Rental'}">
                        <form:fields>
                            <Input
                                value="{ parts: ['Tax', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'}"
                                enabled="false"
                                visible="{= ${ConditionType} !== 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceWtax}" visible="{= ${ConditionType} !== 'Rental'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['NetPriceWithTax', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= ${ConditionType} !== 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceWtaxAfterRC}"
                        visible="false"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['NetPriceWithTaxAfterDeductionRD', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="false"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.RequestedVolume}"
                        visible="{= ${ConditionType} === 'Rental'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['RequestedVolume', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomNumberType'}"
                                enabled="false"
                                visible="{= ${ConditionType} === 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.RentalPrice}"
                        visible="{= ${ConditionType} === 'Rental'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['RentalPrice', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= ${ConditionType} === 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.MonthlyRentPerUnit}"
                        visible="{= ${ConditionType} === 'Rental'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['MonthlyRentPerUnit', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="{= ${ui>/PricingForm/editMode} }"
                                liveChange=".onPricingFormLiveChange($event, 'Rental')"
                                visible="{= ${ConditionType} === 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.AnnualValue}"
                        visible="{= ${ConditionType} === 'Rental'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['AnnualValue', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= ${ConditionType} === 'Rental'}"
                            />
                        </form:fields>
                    </form:FormElement>
                </form:formElements>
            </form:FormContainer>
        </form:formContainers>
    </form:Form>
</core:FragmentDefinition>
