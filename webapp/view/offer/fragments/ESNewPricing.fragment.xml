<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <form:Form
        id="idNewPricingForm"
        editable="true"
    >
        <form:title>
            <core:Title text="{ConditionType}" />
        </form:title>
        <form:layout>
            <form:ResponsiveGridLayout
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="3"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="4"
                emptySpanM="4"
                emptySpanS="0"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false"
            />
        </form:layout>
        <form:formContainers>
            <form:FormContainer>
                <form:formElements>
                    <form:FormElement label="{i18n>ESPricingFragment.PVL}">
                        <form:fields>
                            <Input
                                value="{ parts: ['PVL', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.ConfidentialDiscount}" visible="{= ${ConfidentialDiscount} > 0}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['ConfidentialDiscount', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'}"
                                enabled="false"
                                visible="{= ${ConfidentialDiscount} > 0}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.ConfidentialPrice}" visible="{= ${ConfidentialDiscount} > 0}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['ConfidentialPrice', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= ${ConfidentialDiscount} > 0}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.RoyalDecreeApplies}"
                    >
                        <form:fields>
                            <Select
                                selectedKey="{= ${RoyalDecree} ? ${RoyalDecree} : 'No'}"
                                enabled="false"
                            >
                                <items>
                                    <core:Item
                                        key="No"
                                        text="No"
                                    />
                                    <core:Item
                                        key="Yes"
                                        text="Yes"
                                    />
                                </items>
                            </Select>
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.StandardDiscount}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['StandardDiscount', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'}"
                                enabled="false"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.AdditionalDiscount}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['AdditionalDiscount', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'}"
                                enabled="false"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement label="{i18n>ESPricingFragment.Discount}">
                        <form:fields>
                            <Input
                                value="{ parts: ['Discount', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'}"
                                enabled="{= ${ui>/PricingForm/editMode} &amp;&amp; ${ConditionType} === 'DescuentoComercial' }"
                                liveChange=".onPricingFormLiveChange($event, 'DescuentoComercial')"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.RoyalDecree}" visible="{= ${RoyalDecree} === 'Yes'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['RoyalDecreePercentage_1', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'}"
                                enabled="false"
                                visible="{= ${RoyalDecree} === 'Yes'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceBeforeRC}"
                    >
                        <form:fields>
                            <Input
                                fieldGroupIds="priceInputPrecioNeto"
                                value="{ parts: ['NetPriceWithoutTaxBeforeDeductionRD', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="{= ${ui>/PricingForm/editMode} &amp;&amp; ${ConditionType} === 'PrecioNeto'}"
                                liveChange=".onPricingFormLiveChange($event, 'PrecioNeto')"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.royalDecreeIncl}" visible = "false"
                    >
                        <form:fields>
                            <CheckBox
                                enabled="false"
                                selected="{RoyalDecreeIncl}" 
                                visible = "false"/>
                                <!-- visible="{= ${RoyalDecree} === 'No' &amp;&amp; ${ConditionType} === 'PrecioNeto'}"
                                 select=".onPricingFormLiveChange($event, 'PrecioNeto')" -->
                            
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.RoyalDecreeValue}" visible="{= ${RoyalDecree} === 'Yes' &amp;&amp; ${ConditionType} !== 'DescuentoEspecial'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['RoyalDecreeValue', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= ${RoyalDecree} === 'Yes' &amp;&amp; ${ConditionType} !== 'DescuentoEspecial'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceAfterRC}" visible="{= ${RoyalDecree} === 'Yes' &amp;&amp; ${ConditionType} === 'PrecioNeto'}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['NetPriceWithoutTaxAfterDeductionRD', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= ${RoyalDecree} === 'Yes' &amp;&amp; ${ConditionType} === 'PrecioNeto'}"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.MaximumPrice}"
                    >
                        <form:fields>
                            <Input
                                fieldGroupIds="priceInputPrecioNeto"
                                value="{ parts: ['MaximumPrice', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement label="{i18n>ESPricingFragment.Tax}">
                        <form:fields>
                            <Input
                                value="{ parts: ['Tax', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'}"
                                enabled="false"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceWtax}"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['NetPriceWithTax', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceBeforeRC}" visible="{= ${ConditionType} === 'DescuentoComercial' }"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['NetPriceWithoutTax', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible="{= ${ConditionType} === 'DescuentoComercial' }"
                            />
                        </form:fields>
                    </form:FormElement>
                    <form:FormElement
                        label="{i18n>ESPricingFragment.NetPriceWtaxAfterRC}" visible = "false"
                    >
                        <form:fields>
                            <Input
                                value="{ parts: ['NetPriceWithTaxAfterDeductionRD', 'Currency','Region', 'CountryCode'], 
                        			type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'}"
                                enabled="false"
                                visible = "false"
                            />
                        </form:fields>
                    </form:FormElement>
                </form:formElements>
            </form:FormContainer>
        </form:formContainers>
    </form:Form>
</core:FragmentDefinition>
