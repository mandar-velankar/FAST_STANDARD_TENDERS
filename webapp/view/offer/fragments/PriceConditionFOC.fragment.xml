<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core" 
	xmlns:form="sap.ui.layout.form" 
>
	<form:Form
		id="idFOCForm"
		editable="true"
	>
		<form:toolbar>
			<Toolbar>
				<Title text="{i18n>FOC}"/>
				<ToolbarSpacer />
				<Button
					icon="sap-icon://alert"
					text="{= ${messages>/priceCondFoc}.length }"
					visible="{= ${messages>/priceCondFoc}.length > 0 &amp;&amp; ${ui>/FocForm/editMode}}"
					type="Emphasized"
					press="onMessagePopoverPress($event, 'priceCondFoc')" 
				/>
				<Button
					icon="sap-icon://edit"
					text="Edit"
					press=".onButtonFocFormEditPress"
					enabled="{ui>/FocForm/hasMainPriceCondition}"
					visible="{= !${ui>/FocForm/editMode} }"
				/>
				<Button
					icon="sap-icon://save"
					text="Save"
					press=".onButtonFocFormSavePress"
					visible="{= ${ui>/FocForm/editMode} }"
				/>
				<Button
					icon="sap-icon://decline"
					text="Cancel"
					press=".onButtonFocFormCancelPress"
					visible="{= ${ui>/FocForm/editMode} }"
				/>
			</Toolbar>
		</form:toolbar>
		<form:layout>
			<form:ResponsiveGridLayout
				labelSpanXL="3"
				labelSpanL="3"
				labelSpanM="3"
				labelSpanS="12"
				adjustLabelSpan="false"
				emptySpanXL="4"
				emptySpanL="4"
				emptySpanM="4"
				emptySpanS="0"
				columnsXL="1"
				columnsL="1"
				columnsM="1"
				singleContainerFullSize="false" />
		</form:layout>
		<form:formContainers>
			<form:FormContainer>
				<form:formElements>
					<form:FormElement label="{i18n>PriceConditionFOCFragment.FreeGoodsForOtherProducts}">
						<form:fields>            
							<MultiInput 
								id="idFOCMultiInput"
								valueHelpOnly="true" 
								valueHelpRequest=".onMultiInputProductsValueHelpRequest" 
								enabled="{ui>/FocForm/editMode}"
							>
								<!-- Tokens are bound in the Controller.bindFOCMultiInputTokens method -->
							</MultiInput>
						</form:fields>
					</form:FormElement>	
				</form:formElements>
			</form:FormContainer>
		</form:formContainers>
	</form:Form>

</core:FragmentDefinition>