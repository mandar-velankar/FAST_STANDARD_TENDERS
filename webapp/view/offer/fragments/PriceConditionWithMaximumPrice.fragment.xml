<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core" 
	xmlns:form="sap.ui.layout.form" 
>
	<!-- FORM WITH Pricing DATA -->
	<form:Form
		id="idPricingForm"
		editable="true"
	>
		<form:toolbar>
			<Toolbar>
				<Title text="{i18n>Price}"/>
				<ToolbarSpacer />
				<Button
					icon="sap-icon://alert"
					text="{= ${messages>/priceCondWithMaximumPrice}.length }"
					visible="{= ${messages>/priceCondWithMaximumPrice}.length > 0 &amp;&amp; ${ui>/PricingForm/editMode}}"
					type="Emphasized"
					press="onMessagePopoverPress($event, 'priceCondWithMaximumPrice')" 
				/>
				<Button
					icon="sap-icon://edit"
					text="Edit"
					press=".onPricingFormEditBtnPress"
					visible="{= !${ui>/PricingForm/editMode} }"
					enabled="{= ${ui>/PricingForm/hasOfferProductDetailsSaved} &amp;&amp; ${em>/OfferProductDetail/OfferPricingInfo/editMode}}"  
				/>
				<Button
					icon="sap-icon://save"
					text="Save"
					press=".onPolandPricingFormSaveBtnPress"
					visible="{= ${ui>/PricingForm/editMode} }"
				/>
				<Button
					icon="sap-icon://decline"
					text="Cancel"
					press=".onPolandPricingFormCancelBtnPress"
					visible="{= ${ui>/PricingForm/editMode} }"
				/>
			</Toolbar>
		</form:toolbar>
		<form:layout>
			<form:ResponsiveGridLayout
				labelSpanXL="3"
				labelSpanL="3"
				labelSpanM="3"
				labelSpanS="12"
				adjustLabelSpan="false"
				emptySpanXL="4"
				emptySpanL="4"
				emptySpanM="4"
				emptySpanS="0"
				columnsXL="1"
				columnsL="1"
				columnsM="1"
				singleContainerFullSize="false" />
		</form:layout>
		<form:formContainers>
			<form:FormContainer>
				<form:formElements>
					<form:FormElement label="{i18n>PriceConditionWithMaximumPriceFragment.MaximumPrice}" >
						<form:fields>
							<Input value="{
										parts: ['Price1', 'Currency', 'Region', 'CountryCode'],
										type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'	
									}"  
									liveChange=".onPricingFormLiveChange($event, 'WithMaximumPrice')"
									enabled="{= ${ui>/PricingForm/editMode} &amp;&amp; (${st>/UserInfo/Role} === 'Tender Manager' || ${st>/UserInfo/Role} === 'KAM' || ${st>/UserInfo/Role} === 'Sales Manager')}"
									 />
						</form:fields>
					</form:FormElement>
					<form:FormElement label="{i18n>PriceConditionWithMaximumPriceFragment.MaximumWholesalerMargin}">
						<form:fields>
							<Input value="{
										parts: ['Level2Discount1', 'CountryCode'],
										type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'	
									}"  
									liveChange=".onPricingFormLiveChange($event, 'WithMaximumPrice')"
									enabled="{= ${ui>/PricingForm/editMode} &amp;&amp; ${st>/UserInfo/Role} === 'Tender Manager'}" />
						</form:fields>
					</form:FormElement>
					<form:FormElement label="{i18n>PriceConditionWithMaximumPriceFragment.SpecialPrice}" >
						<form:fields>
							<Input
								value="{
									parts: ['SpecialPrice', 'Currency', 'Region', 'CountryCode'],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'	
								}" 
								enabled="false" 
							/>
						</form:fields>
					</form:FormElement>
                    <form:FormElement label="{i18n>PriceConditionWithMaximumPriceFragment.COGS}" visible="{= ${st>/UserInfo/Role} === 'Tender Manager'}">
						<form:fields>
							<Input
								value="{
									parts: ['COGS', 'Currency', 'Region', 'CountryCode'],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomCurrencyType'
								}" 
								enabled="false"
							/>
						</form:fields>
					</form:FormElement>
                    <form:FormElement label="{i18n>PriceConditionWithMaximumPriceFragment.Margin}" visible="{= ${st>/UserInfo/Role} === 'Tender Manager'}">
						<form:fields>
							<Input
								value="{
									parts: [ 'Margin', 'CountryCode'],
									type: 'com.bayer.tender.statenderapp.model.datatypes.CustomPercentageType'
								}" 
								enabled="false"
							/>
						</form:fields>
					</form:FormElement>
				</form:formElements>
			</form:FormContainer>
		</form:formContainers>
	</form:Form>

</core:FragmentDefinition>