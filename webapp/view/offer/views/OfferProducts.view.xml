<mvc:View controllerName="com.bayer.tender.statenderapp.controller.OfferProducts.OfferProducts" 
	xmlns="sap.m"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt">

	
	<VBox>
		<form:Form
			id="idOfferForm"
			editable="true"
			formContainers="{path:'template>xmlView/formByName/OfferForm/formContainers',templateShareable:true}">
			<form:title>
				<core:Title text="{template>title}" />
			</form:title>
			<form:toolbar>
				<Toolbar>
					<Title text="{template>title}"/>
					<ToolbarSpacer />
					<Button text="New Offer" icon="sap-icon://add" press=".onOpenCreateOfferDialog" visible="{= !${ui>/OfferForm/editMode} }"/>
					<Button text="Copy Offer" icon="sap-icon://duplicate" press="onCopyOffer" visible="{= !${ui>/OfferForm/editMode} }" />
					<Button text="Delete Offer" icon="sap-icon://delete" press="onDeleteProductOffer" visible="{= !${ui>/OfferForm/editMode} }" type="Reject"/>
					<Button id="editOfferButtonId" icon="sap-icon://edit" text="Edit" press=".onOfferFormEditBtnPress" visible="{= !${ui>/OfferForm/editMode} }"/>
					<Button
						id="idOfferFormSaveBtn"
						icon="sap-icon://save"
						text="Save"
						press=".onOfferFormSaveBtnPress"
						visible="{= ${ui>/OfferForm/editMode} }"
						type="Accept"
					/>
					<Button
						id="idOfferFormCancelBtn"
						icon="sap-icon://decline"
						text="Cancel"
						press=".onOfferFormCancelBtnPress"
						visible="{= ${ui>/OfferForm/editMode} }"
						type="Reject"
					/>
				</Toolbar>
			</form:toolbar>
			<form:layout>
				<form:ResponsiveGridLayout labelSpanL="12" labelSpanM="12"
				emptySpanL="0" emptySpanM="0" columnsL="3" columnsM="3" columnsXL="3" class="editableForm" backgroundDesign="Solid" />
			</form:layout>
			<form:formContainers>
				<form:FormContainer formElements="{path:'template>formElements',templateShareable:true}">
					<form:formElements>
						<form:FormElement label="{template>label}" fields="{path:'template>controls',factory:'.fieldsFactory',templateShareable:true}">
							<!-- <form:fields>
								<Input value="{template>control/type}"/>
							</form:fields> -->
						</form:FormElement>
					</form:formElements>
				</form:FormContainer>
			</form:formContainers>
		</form:Form>
	</VBox>

	<VBox class='sapUiMediumMargin'>
		<Table id="idOfferProductsTable" 
			columns="{path:'template>xmlView/tableByName/OfferProductsTable/columns'}"
			class="sapFDynamicPageAlignContent"
			width="auto"
			mode="SingleSelectMaster"
			selectionChange=".onOfferProductPress">
			<headerToolbar>
				<OverflowToolbar>
					<content>
						<Title text="{path:'template>xmlView/tableByName/OfferProductsTable/title'}" level="H2"/>
						<ToolbarSpacer />
					</content>
				</OverflowToolbar>
			</headerToolbar>
			<columns>
				<Column>
					<Text text="{template>title}" />
				</Column>
			</columns>
		</Table>
	</VBox>	
	<VBox class='sapUiMediumMargin' justifyContent="End" alignItems="End">
		<Text id='idTotalAmountOfferProducts' text='{= ${OfferTotal} ? "Offer Total: " + ${OfferTotal} + " EUR" : "Offer Total: 0 EUR" }' />
	</VBox>	

</mvc:View>