<mvc:View controllerName="com.bayer.tender.statenderapp.controller.OfferProducts.OfferProducts"
		xmlns="sap.m"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt">


	<Panel expandable="false" width="auto" class="sapUiResponsiveMargin" backgroundDesign="Solid">
		<headerToolbar>
			<OverflowToolbar style="Standard" design="Solid">
				<Title text="Tender Offer" />
				<ToolbarSpacer />
				<Button text="New Offer" icon="sap-icon://add" press="onCreateProductOffer"/>
				<Button text="Copy Offer" icon="sap-icon://duplicate" press="onCopyOffer" enabled="true" />
				<Button text="Delete Offer" icon="sap-icon://delete" press="onDeleteProductOffer" enabled="true"/>
			</OverflowToolbar>
		</headerToolbar>
		<content>	
			<form:SimpleForm editable="true" id="nameform" maxContainerCols="1" layout="ResponsiveGridLayout" labelSpanL="12" labelSpanM="12"
				emptySpanL="9" emptySpanM="9" columnsL="1" columnsM="1" class="editableForm" backgroundDesign="Solid">
				<form:content>
					<Label text="Offer Name" design="Bold" required="true"/>
					<Input value="AE-15-100-1001-1"  enabled="false"/>
				</form:content>
			</form:SimpleForm>	

			<!-- FORM WITH OFFER DATA -->
			<form:SimpleForm editable="true" id="editForm" maxContainerCols="3" layout="ResponsiveGridLayout" labelSpanL="12" labelSpanM="12"
				emptySpanL="0" emptySpanM="0" columnsL="3" columnsM="3" class="editableForm" backgroundDesign="Solid">
				<form:content>
					
					<core:Title/>

					<Label text="{i18n>didtrbtrnme}" design="Bold" required="true"/>
					<Select id="idDistributorName" 
						enabled="false"
						selectedKey="Pharmaworld"
						change="onChangeDistributor"
						visible="true">
						<core:Item text="Pharmaworld" key="Pharmaworld"/>
					</Select>

					<Label text="{i18n>selncmpny}" design="Bold" required="true"/>
					<Select id="idSellingCompany" 
							selectedKey="BPH" 
							change="onChangeSellingCompany"
							enabled="false">
						<core:Item text="BPH" key="BPH"/>
					</Select>
					<core:Title/>
					
					<Label text="{i18n>intrnlduedte}" required="true"/>
					<!--<DatePicker id="idintrDueDte" value="{path :'fastAppData>/EditOffer/InternalBidDueDate',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}" valueFormat="dd-MM-yyyy" displayFormat="dd.MM.yyyy" />-->
					<DatePicker id="idintrDueDte" minDate="{dateModel>/minDate}" value="{path :'InternalBidDueDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false"/>
					
					<Label text="{i18n>ofrduedte}"/>
					<!--<Text text="{path :'fastData>BidDueDate',formatter:'FAST_NS0FAST0.utils.Formatter.bdate'}"/>-->
					<DatePicker id="idOrfDueDate" value="{path :'fastData>BidDueDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy' , UTC:true}}" enabled="false"/>
					
					<core:Title/>
					
					<Label text="{i18n>whlseofr}" required="true"/>
					<Select id="idWhleSle" enabled="false" selectedKey="{fastAppData>/EditOffer/WholesaleOffer}" visible="{= ${fastAppData>/Tender/CountryCode} === 'TH' || ${fastAppData>/Tender/CountryCode} === 'AR' || ${fastAppData>/Tender/CountryCode} === 'CL'  || ${fastAppData>/Tender/CountryCode} === 'IT' ? false : true}">
						<items>
							<core:Item text="No" key="No"/>
							<core:Item text="Yes" key="Yes"/>
						</items>
					</Select>

					<Label text="{i18n>Division}" required="true"/>
					<Select id="idProductOfferDivision" selectedKey="{fastAppData>/EditOffer/Division}" enabled="false" visible="true" change="onChangeDivision">
							<items>
								<core:Item text="" key=""/>
								<core:Item text="Pharma" key="Pharma"/>
								<core:Item text="Radiology" key="Radiology"/>
							</items>
					</Select>			
					<!-- <Text id="idDistID" text="{fastAppData>/EditOffer/Distributor/DistributorID}" visible="false"/> -->
					
				</form:content>
			</form:SimpleForm>					
		</content>
	</Panel>

	<Panel expandable="false" width="auto" class="sapUiResponsiveMargin" backgroundDesign="Solid">
		<headerToolbar>
			<OverflowToolbar style="Standard" design="Solid">
				<Title text="Products" />
			</OverflowToolbar>
		</headerToolbar>
		<content>
			<Table id="productInformationTableId" 
				mode="SingleSelectMaster"
				selectionChange=".onOfferProductPress">
				<columns>
					<Column>
						<Label text="Product" wrapping="true"/>
					</Column>
					<Column>
						<Label text="Requested Volume" wrapping="true"/>
					</Column>
					<Column>	
						<Label text="Net Price" wrapping="true"/>
					</Column>
					<Column>	
						<Label text="Total Amount" wrapping="true"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem  press="onOfferProductPress" detailPress="onOfferProductPress">
						<cells>
							<Text text="ADEMPAS 0,5MG 42TAB"/>	
							<Text text="100 Units"/>		
							<Text text="77.9 EUR"/>
							<Text text="7,790 EUR"/>	
						</cells>
					</ColumnListItem>
					<ColumnListItem  press="onOfferProductPress" detailPress="onOfferProductPress">
						<cells>
							<Text text="ADEMPAS 2,0MG 42TAB"/>
							<Text text="100 Units"/>		
							<Text text="77.9 EUR"/>
							<Text text="7,790 EUR"/>	
						</cells>
					</ColumnListItem>
					<ColumnListItem  press="onOfferProductPress" detailPress="onOfferProductPress">
						<cells>
							<Text text="ADEMPAS 2,5MG 42TAB"/>
							<Text text="100 Units"/>		
							<Text text="77.9 EUR"/>
							<Text text="7,790 EUR"/>			
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Panel>

</mvc:View>